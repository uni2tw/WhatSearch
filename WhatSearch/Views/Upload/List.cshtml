@using WhatSearch.Controllers
@using WhatSearch.Utility
@{
    this.Layout = "_Layout.cshtml";
}

@section header {
    <style>
        .file-input-plain {
            border: none;
            background: transparent;
            padding: 10px 0;
            font-size: 1.3rem;
        }
        progress {
            width: 100%;
            height: 3em;
            color: black;
            font-size: 1.5em;
            text-align: center;
            padding-top:.7em;
            font-weight:bold;
        }
        progress:before {
            content: attr(data-label);
        }
        .table tbody tr {
            border-bottom: 1px dashed lightgrey;
        }
        .nav-menu {
            color: black;
            border: 1px solid darkgray;
            background-color: white !important;
            font-size: 2em;
            padding: 0.2em 0px;
            box-shadow: 3px 0px 5px;
        }
        .nav-menu-item {
            text-align: center;
            padding: .4em 1em;
        }
    </style>
}



<body>
    <div id="app">
        <nav class="navbar navbar-dark bg-dark sticky-top">
            <div style="flex-grow:1;width:80%;display:flex;align-items:center;color: silver; gap:8px; flex-wrap:wrap;">
                <div style="display:flex; font-size:1.5rem; font-family: monospace">
                    上傳(最大@(ViewBag.LimitMb)MB)
                </div>
                <span class="badge fs-6" :class="secret ? 'bg-success' : 'bg-danger'">{{ badgeLabel }}</span>
                <button v-if="isPublicShare" type="button" class="btn btn-sm btn-outline-light" v-on:click="copyLink()">
                    <i class="fa fa-copy"></i> 複製連結
                </button>
            </div>
            <div style="width:36px; padding-left:2px">
                <button type="button" v-on:click="openMenu()" class="btn btn-success btn">
                    <i class="fa fa-list"></i>
                </button>
            </div>
        </nav>
        <div v-if="menuOn" class="nav-menu">
            <div v-on:click="go_public()" class="nav-menu-item">公開區</div>
            <div v-on:click="go_secret()" class="nav-menu-item">私人區</div>
            <div v-on:click="go_public_secret()" class="nav-menu-item">私人區(分享用)</div>
        </div>
        <div class="container-fluid" v-cloak>
            <div style="display:flex">
                <input v-on:change="startUploadFile" id="picFile" type="file" ref="picFile" class="file-input-plain"
                       multiple="multiple"
                       accept="application/msword,image/gif,image/jpeg,application/pdf,image/png,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/zip,.doc,.gif,.jpeg,.jpg,.pdf,.png,.xls,.xlsx,.zip,.mov" />
            </div>
            <div>
                <progress :value="progress" :data-label="progressText"></progress>
            </div>
            <h1>列表(保存3天)</h1>
            <table class="table">
                    <tr v-for="item in items">
                        <td style="font-size:1.5em; word-break:break-all">
                            <a v-if="!secret" :href="'/upload/file/' + item.id">{{item.title}}</a>
                            <a v-if="secret" :href="'/upload/' + secret + '/file/' + item.id">{{item.title}}</a>
                        </td>
                        <td>{{item.size}}</td>
                        <td>{{item.time}}</td>
                        <td>{{item.deleteAfter}}</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-danger" v-on:click="deleteFile(item)">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
            </table>
        </div>

        <div v-if="toastVisible" style="position:fixed; bottom:20px; left:50%; transform:translateX(-50%); background:#333; color:#fff; padding:10px 20px; border-radius:6px; z-index:2500;">{{ toastMessage }}</div>

        <div v-if="confirmDialog.visible" style="position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.6); z-index:3000; display:flex; align-items:center; justify-content:center;">
            <div style="background:#fff; color:#000; padding:20px; border-radius:8px; max-width:90%; width:360px;">
                <div style="margin-bottom:16px; white-space:pre-wrap;">{{ confirmDialog.message }}</div>
                <div style="display:flex; justify-content:flex-end; gap:8px;">
                    <button type="button" class="btn btn-outline-secondary" v-on:click="vm_confirmNo()">取消</button>
                    <button type="button" class="btn btn-success" v-on:click="vm_confirmYes()">確定</button>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">

        const App = {
            watch: {
                chunks: {
                  handler(n, o) {
                      if (this.enableWatch) {
                        this.upload();
                      }
                  },
                  deep: true
                }
            },
            data() {
                return {
                    items:[],
                    menuOn: false,
                    secret: '@ViewBag.Secret',
                    file: null,
                    uploaded: 0,
                    fileUploaded:0,
                    fileTotal:0,
                    enableWatch: false,
                    chunks: [],
                    queuedFiles: [],
                    toastVisible: false,
                    toastMessage: '',
                    confirmDialog: { visible: false, message: '', resolve: null }
                }
            },
            computed: {
                progress() {
                    if (this.file == null) {
                        return 0;
                    }
                    return this.uploaded / this.file.size;
                },
                progressText() {
                    if (this.file == null) {
                        return '';
                    }
                    var val = Math.ceil(this.uploaded * 100 / this.file.size);
                    if (val >= 100) {
                        return val.toString() + '% 完成' + ' - ' + this.fileUploaded + ' / ' + this.fileTotal;;
                    } else {
                        return val.toString() + '%' + ' - ' + this.fileUploaded + ' / ' + this.fileTotal;
                    }
                },
                apiStatusUrl() {
                    if (this.secret) {
                        return '/upload/' + this.secret + '/status';
                    } else {
                        return '/upload/status';
                    }
                },
                apiPostUrl() {
                    if (this.secret) {
                        return '/upload/' + this.secret + '/post';
                    } else {
                        return '/upload/post';
                    }
                },
                apiItemsUrl() {
                    if (this.secret) {
                        return '/upload/' + this.secret + '/items';
                    } else {
                        return '/upload/items';
                    }
                },
                apiDeleteUrl() {
                    if (this.secret) {
                        return '/upload/' + this.secret + '/delete';
                    } else {
                        return '/upload/delete';
                    }
                },
                clientSecret() {
                    var secret = localStorage.getItem('secret');
                    return secret;
                },
                clientPublicSecret() {
                    var secret = localStorage.getItem('public_secret');
                    return secret;
                },
                badgeLabel() {
                    if (!this.secret) {
                        return '公開';
                    }
                    if (this.secret.length == 6) {
                        return '私人分享 - ' + this.secret;
                    }
                    return '私人';
                },
                isPublicShare() {
                    return !!this.secret && this.secret.length == 6;
                }
            },
            methods: {
                openMenu() {
                    this.menuOn = !this.menuOn;
                },
                showToast(message) {
                    this.toastMessage = message;
                    this.toastVisible = true;
                    clearTimeout(this._toastTimer);
                    this._toastTimer = setTimeout(() => {
                        this.toastVisible = false;
                    }, 2500);
                },
                copyLink() {
                    var self = this;
                    navigator.clipboard.writeText(location.href).then(function () {
                        self.showToast('連結已複製');
                    }).catch(function () {
                        self.showToast('複製失敗，請手動複製網址');
                    });
                },
                vm_confirm(message) {
                    var self = this;
                    return new Promise(function (resolve) {
                        self.confirmDialog.message = message;
                        self.confirmDialog.visible = true;
                        self.confirmDialog.resolve = resolve;
                    });
                },
                vm_confirmYes() {
                    this.confirmDialog.visible = false;
                    if (this.confirmDialog.resolve) {
                        this.confirmDialog.resolve(true);
                    }
                },
                vm_confirmNo() {
                    this.confirmDialog.visible = false;
                    if (this.confirmDialog.resolve) {
                        this.confirmDialog.resolve(false);
                    }
                },
                loadItems() {
                    var self = this;
                    axios.get(this.apiItemsUrl).then(function (res) {
                        self.items = res.data;
                    });
                },
                deleteFile(item) {
                    var self = this;
                    this.vm_confirm('確定要刪除「' + item.title + '」嗎？').then(function (ok) {
                        if (!ok) {
                            return;
                        }
                        axios.post(self.apiDeleteUrl, { file_name: item.id }).then(function () {
                            self.showToast('已刪除');
                            self.loadItems();
                        }).catch(function () {
                            self.showToast('刪除失敗');
                        });
                    });
                },
                go_public() {
                    location.href = '/upload';
                },
                go_secret() {
                    if (this.clientSecret) {
                        location.href = '/' + this.clientSecret + '/upload';
                    } else {
                        location.href = '/upload/secret';
                    }
                },
                go_public_secret() {
                    if (this.clientPublicSecret) {
                        location.href = '/' + this.clientPublicSecret + '/upload';
                    } else {
                        location.href = '/upload/public_secret';
                    }
                },
                reset() {
                    this.file = null;
                    this.uploaded = 0;
                    this.chunks = [];
                    document.getElementById('picFile').value = '';
                    this.fileTotal = 0;
                    this.fileUploaded = 0;
                    this.queuedFiles = [];
                },

                createChunks(uploaded) {
                    uploaded = uploaded || 0;
                    let size = 512 * 1024;
                    let chunks = Math.ceil((this.file.size - uploaded) / size);
                    for (let i = 0; i < chunks; i++) {
                        let start = uploaded + (i * size);
                        var chunk = this.file.slice(
                            start, Math.min(start + size, this.file.size), this.file.type
                        );
                        this.chunks.push(chunk);
                    }
                },

                startUploadFile() {
                    let files = this.$refs.picFile.files;
                    console.log(files);
                    if (files.length > 0) {
                        this.fileTotal = files.length;
                        this.queuedFiles = this.$refs.picFile.files;
                        this.startUploadTheFile(files[0]);
                    }
                },

                startUploadTheFile(theFile) {
                    console.log('enableWatch start.');
                    this.file = theFile;
                    let config = {
                        headers: {
                            'Content-Type': 'multipart/form-data'
                        }
                    }
                    let fd = new FormData;
                    fd.set('file_name', this.file.name);
                    var self = this;
                    axios.post(this.apiStatusUrl, fd, config).then(function (res) {
                        self.enableWatch = true;
                        let data = res.data;
                        if (data.loc == 'temp') {
                            self.vm_confirm(data.message).then(function (ok) {
                                if (ok) {
                                    self.uploaded = data.len;
                                    self.createChunks(data.len);
                                } else {
                                    self.reset();
                                }
                            });
                        } else if (data.loc == 'folder') {
                            self.vm_confirm(data.message).then(function (ok) {
                                if (ok) {
                                    self.uploaded = 0;
                                    self.createChunks();
                                } else {
                                    self.reset();
                                }
                            });
                        } else {
                            self.uploaded = 0;
                            self.createChunks();
                        }
                    }).catch(err => {
                        console.log('err', err);
                    });
                },


                upload: function () {

                    const self = this;

                    let config = {
                        headers: {
                            'Content-Type': 'multipart/form-data'
                        }
                    }

                    let fd = new FormData;

                    fd.set('file_name', this.file.name);
                    fd.set('is_start', this.uploaded == 0 ? 'true' : 'false');
                    fd.set('is_end', this.chunks.length == 1 ? 'true' : 'false');
                    fd.set('file', this.chunks[0]);

                    this.uploaded += this.chunks[0].size;

                    axios.post(this.apiPostUrl, fd, config).then(res => {
                        if (self.chunks.length == 1) {
                            //TODO stop watch
                            console.log('enableWatch stop.');
                            this.enableWatch = false;
                        }
                        self.chunks.shift();
                        if (self.chunks.length == 0) {
                            self.fileUploaded++;
                            console.log(`it is start of ${self.fileUploaded}`);
                            if (self.fileUploaded < self.fileTotal) {
                                self.startUploadTheFile(self.queuedFiles[self.fileUploaded]);
                            } else {
                                self.showToast('上傳完成');
                                self.loadItems();
                                self.reset();
                            }
                        }
                    }).catch(err => {
                        console.log(err.response);
                        alert(err.response.data);
                        self.reset();
                    }).then(res => {
                    });


                },
                dumpUrls: function() {
                    let urls = [];
                    for (i in this.items) {
                        let item = this.items[i];
                        if (this.secret){
                            urls.push(location.origin + '/upload/' + this.secret + '/file/' + item.id);
                        } else {
                            urls.push(location.origin + '/upload/file/' + item.id);
                        }
                    }
                    console.log(urls.join('\n'));
                }
            },
            mounted: function () {
                if (this.secret != null && this.secret.length == 36) {
                    if (this.secret && this.clientSecret &&
                        this.secret != this.clientSecret) {
                        if (window.confirm('使用這個區域當做個人區域')) {
                            localStorage.setItem('secret', this.secret);
                        }
                    } else if (this.secret) {
                        localStorage.setItem('secret', this.secret);
                    }
                }
                if (this.secret != null && this.secret.length == 6) {
                    if (this.secret && this.clientPublicSecret &&
                        this.secret != this.clientPublicSecret) {
                        if (window.confirm('使用這個區域當做個人區域')) {
                            localStorage.setItem('public_secret', this.secret);
                        }
                    } else if (this.secret) {
                        localStorage.setItem('public_secret', this.secret);
                    }
                }
            }
        };

        app = Vue.createApp(App).mount('#app');

        @{
            var jsonOptions = new System.Text.Json.JsonSerializerOptions
            {
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            };
            var filesJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.Items, jsonOptions);
            @Html.Raw("app.items = " + filesJson);
        }

    </script>
</body>
