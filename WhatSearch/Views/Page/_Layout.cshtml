@using WhatSearch.Controllers
@using WhatSearch.Utility
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
  <meta name="description" content="">
  <meta name="author" content="">
  <link rel="shortcut icon" href="/assets/favicon.ico" type="image/x-icon" />

  <title>@Helper.GetProductVersion()</title>

  <!-- Bootstrap core CSS (CSS only - no JS components are used in this project, so Bootstrap's JS bundle and jQuery are not loaded) -->
  <link type="text/css" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link type="text/css" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css" />

  @Helper.ContentCss("site.css")


  <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.1.2/axios.min.js"></script>

  <script type="text/javascript" src="https://unpkg.com/vue@3"></script>

  @Helper.ContentJs("api.js")

  @RenderSection("header", false)

</head>

@RenderBody()

@RenderSection("footer", false)

</html>


