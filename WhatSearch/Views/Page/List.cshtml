                            <i :class="favAlbumMap[currentFolderId] ? 'fa-solid fa-heart' : 'fa-regular fa-heart'"></i>
                            {{ favAlbumMap[currentFolderId] ? '已收藏' : '收藏' }}
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="切換列表檢視" v-on:click="showListView = true">
                            <i class="fa fa-list"></i> 列表
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div v-if="favView" style="padding:8px 5px 0; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <button type="button" class="btn btn-sm" :class="favTab === 'album' ? 'btn-success' : 'btn-outline-success'"
                v-on:click="favTab = 'album'">專輯 ({{ favAlbumCount }})</button>
            <button type="button" class="btn btn-sm" :class="favTab === 'track' ? 'btn-success' : 'btn-outline-success'"
                v-on:click="favTab = 'track'">單曲 ({{ favTrackCount }})</button>
            <label v-if="favTab === 'track'" style="font-size:14px; cursor:pointer; user-select:none; margin-left:6px;">
                <input type="checkbox" v-model="loudnessOn" /> 音量平衡<span v-if="favTarget !== null" style="color:#999;">（目標 {{ favTarget }} LUFS）</span>
            </label>
        </div>
        <div v-if="favView && items.length === 0 && !loading" style="padding:32px 16px; text-align:center; color:#888;">
            <template v-if="favTab === 'album'">還沒有收藏專輯。<br />在專輯頁按「收藏」，就會出現在這裡。</template>
            <template v-else>還沒有收藏單曲。<br />點歌曲旁的愛心，就會出現在這裡，可以連續播放。</template>
        </div>
        <div v-if="hasMusicItems" style="padding:5px; display:flex; gap:16px; flex-wrap:wrap; font-size:14px;">
            <label style="cursor:pointer; user-select:none;">
                <input type="checkbox" v-model="autoNext" /> 自動下一首
            </label>
            <label :style="{cursor: autoNext ? 'pointer' : 'not-allowed', userSelect: 'none', opacity: autoNext ? 1 : 0.5}">
                <input type="checkbox" v-model="autoLoop" :disabled="!autoNext" /> 播完重頭開始
            </label>
            <label v-if="transcodeEnabled && hasTranscode" style="cursor:pointer; user-select:none;" title="FLAC 預設播放伺服器轉好的 MP3（192 kbps，省頻寬）；勾選後改播原始 FLAC（無損，檔案大）">
                <input type="checkbox" v-model="flacOriginal" /> FLAC 播原檔
            </label>
            <span v-if="transcodeEnabled && hasTranscode && transcodePendingCount > 0" class="tc-badge tc-pending"><i class="fa fa-spinner fa-spin"></i> MP3 轉檔中 {{ transcodePendingCount }} 首</span>
            <span v-if="transcodeNote" style="color:#b26a00;">{{ transcodeNote }}</span>
        </div>
        <div v-if="musicGridVisible">
            <template v-for="g in musicFolder.groups" :key="g.title">
                <div v-if="musicFolder.groups.length > 1" class="disc-header">
                    {{ g.title }} · {{ g.tracks.length }} 首<span v-if="g.seconds"> · {{ formatDuration(g.seconds) }}</span>
                </div>
                <div v-for="t in g.tracks" :key="t.item.id"
                        v-on:click="vm_itemOver(t.item.id); vm_changeFolder(t.item)"
                        class="track-row" :class="{'selected-item-row': t.item.selected, 'track-playing': t.item.playing}">
                    <div class="track-no"><i v-if="t.item.playing" class="fa fa-volume-high"></i><span v-else>{{ t.no }}</span></div>
                    <div class="track-main">
                        <div class="track-title">{{ t.title }}</div>
                        <div v-if="t.artist" class="track-artist">{{ t.artist }}</div>
                        <div v-if="t.item.transcode_state && t.item.transcode_state !== 'ready'" class="tc-badge" :class="'tc-' + t.item.transcode_state"><i v-if="t.item.transcode_state === 'pending'" class="fa fa-spinner fa-spin"></i> {{ vm_transcodeText(t.item) }}</div>
                    </div>
                    <div class="track-dur">{{ t.item.duration ? formatDuration(t.item.duration) : '' }}</div>
                    <div v-if="isLoggedIn" class="fav-btn" :class="{'fav-on': favTrackMap[t.item.id]}" title="加入最愛"
                        v-on:click.stop="vm_toggleFav('track', t.item.id)">
                        <i :class="favTrackMap[t.item.id] ? 'fa-solid fa-heart' : 'fa-regular fa-heart'"></i>
                    </div>
                </div>
            </template>
        </div>
        <div v-if="searchIsVisible && searchPerformed && items.length === 0"
                style="padding:32px 16px; text-align:center; color:#888;">
            <div style="margin-bottom:12px;">找不到符合「{{ keyword }}」的結果</div>
            <button type="button" class="btn btn-success btn-sm" v-on:click="vm_backToBrowse()">
                <i class="fa fa-arrow-left"></i> 回瀏覽模式
            </button>
        </div>
        <template v-if="!videoGridVisible && !musicGridVisible">
        <div v-for="(item, index) in items" v-on:click="vm_itemOver(item.id); vm_changeFolder(item)"
                :class="{'item-row': true, 'selected-item-row': item.selected}"
                style="display:flex; padding:10px 5px; width:100%; cursor:pointer; min-height:48px; align-items:center;"
                >
            <a :name="item.id"></a>
            <div style="height:40px;" class="ps-1 pe-2">
                <i v-if="item.type == 'folder'" class="fa fa-folder-open pull-left"
                    style="font-size:32px;color:orange;"></i>
                <i v-else-if="item.type == 'video'" class="fa fa-file-video pull-left"
                    style="font-size:32px;color:silver;"></i>
                <i v-else-if="item.type == 'music'" class="fa fa-file-audio pull-left audio-icon" :class="{'audio-playing': item.playing}"></i>
                <i v-else-if="item.type == 'image'" class="fa fa-file-image pull-left"
                    style="font-size:32px;color:silver;"></i>
                <i v-else-if="item.type == 'text'" class="fa fa-file-lines pull-left"
                    style="font-size:32px;color:silver;"></i>
                <i v-else class="fa fa-file-lines pull-left"
                    style="font-size:32px;color:silver;"></i>
            </div>
            <div style="flex-grow:2; width:70%">
                <div style="display:flex; flex-direction:column">
                    <div style="font-size: 18px; line-height:20px;overflow:auto; white-space:nowrap">{{ item.rateable ? item.title_plain : item.title }}<span v-if="item.news_kind" class="news-new">{{ vm_newsBadgeText(item) }}</span><span v-if="item.unplayable" class="unplay-tag"><i class="fa fa-ban"></i> 無法播放</span></div>
                    <div v-if="item.artist || item.album" style="font-size: 11px;line-height:14px; color:#999; overflow:auto; white-space:nowrap">{{ formatArtistAlbum(item) }}</div>
                    <div v-if="item.path" style="font-size: 11px;line-height:14px; color:#999; overflow:auto; white-space:nowrap">{{ item.path }}</div>
                    <div v-if="item.type === 'music' && item.transcode_state && item.transcode_state !== 'ready'" class="tc-badge" :class="'tc-' + item.transcode_state"><i v-if="item.transcode_state === 'pending'" class="fa fa-spinner fa-spin"></i> {{ vm_transcodeText(item) }}</div>
                    <div v-if="favView && favTab === 'track' && item.loudness_state" style="font-size: 11px;line-height:14px; color:#999; white-space:nowrap">{{ vm_loudnessText(item) }}</div>
                    <div style="font-size: 12px;line-height:12px; color:gray; display:flex; flex-direction:row; justify-content:space-between; align-items:center; gap:8px;">
                        <div v-if="item.rateable" style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{ vm_shortDate(item.modify) }}</div>
                        <div v-else style="padding-left:0px; width:50%; ">{{ item.modify }}</div>
                        <div v-if="item.rateable" class="rating-open rating-inline" v-on:click.stop="vm_openItemRating(item)">
                            <span class="rating-stars">
                                <span v-for="n in 5" :key="n" class="rstar" :class="{'rstar-off': !(item.rating >= n - 0.5)}" style="width:19px; height:24px; font-size:14px;">
                                    <i :class="vm_starClass(item.rating, n)"></i>
                                </span>
                            </span>
                        </div>
                        <div v-else-if="item.album_rating" class="rating-inline" style="width:40%; text-align:right">
                            <span class="rating-stars">
                                <span v-for="n in 5" :key="n" class="rstar" :class="{'rstar-off': !(item.album_rating >= n - 0.5)}" style="width:19px; height:24px; font-size:14px;">
                                    <i :class="vm_starClass(item.album_rating, n)"></i>
                                </span>
                            </span>
                        </div>
                        <div v-else style="width:40%; text-align:right">{{ item.duration ? formatDuration(item.duration) + ' · ' : '' }}{{ item.size }}</div>
                    </div>
                </div>
            </div>
            <div v-if="vm_canFav(item)" class="fav-btn" :class="{'fav-on': vm_isFav(item)}" title="加入最愛"
                v-on:click.stop="vm_toggleFav(item.type === 'folder' ? 'album' : 'track', item.id)">
                <i :class="vm_isFav(item) ? 'fa-solid fa-heart' : 'fa-regular fa-heart'"></i>
            </div>
        </div>
        </template>
        <footer>
            <div style="display:flex">
                <div style="width:50%"></div>
                <div style="width:50%"><p style="text-align:right">{{footerMessage}}</p></div>                
            </div>
        </footer>
