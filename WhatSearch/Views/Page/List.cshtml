    <div v-if="ratingPicker" class="rating-overlay" v-on:click.self="vm_closeRatingPicker()">
        <div class="rating-sheet">
            <div style="font-weight:bold; font-size:16px; word-break:break-all;">{{ ratingPicker.name }}</div>
            <div style="display:flex; align-items:center; margin:2px 0 12px; font-size:15px;">
                <span class="rating-stars">
                    <span v-for="n in 5" :key="n" class="rstar" :class="{'rstar-off': !(ratingPicker.pending >= n - 0.5)}" style="width:32px; height:36px; font-size:24px;">
                        <i :class="vm_starClass(ratingPicker.pending, n)"></i>
                    </span>
                </span>
                <span style="margin-left:8px; font-weight:bold;">{{ ratingPicker.pending > 0 ? ratingPicker.pending : '未評分' }}</span>
                <span v-if="ratingPicker.pending !== ratingPicker.value" style="margin-left:8px; font-size:12px; color:#e0a800;">尚未儲存</span>
            </div>
            <div class="rating-sheet-grid">
                <button v-for="v in ratingChoices" :key="v" type="button" class="btn"
                    :class="ratingPicker.pending === v ? 'btn-success' : 'btn-outline-success'"
                    style="min-height:58px; font-size:22px; font-weight:bold; padding:0;"
                    v-on:click="vm_selectRating(v)">{{ v }}</button>
            </div>
            <div style="display:flex; gap:8px; margin-top:14px;">
                <button type="button" class="btn btn-outline-danger" style="flex:1 1 0; min-height:48px; padding:0 4px;" v-on:click="vm_selectRating(0)">清除評分</button>
                <button type="button" class="btn btn-outline-secondary" style="flex:1 1 0; min-height:48px; padding:0 4px;" v-on:click="vm_closeRatingPicker()">取消</button>
                <button type="button" class="btn btn-success" style="flex:1 1 0; min-height:48px; padding:0 4px; font-weight:bold;"
                    :disabled="ratingPicker.pending === ratingPicker.value" v-on:click="vm_confirmRating()">確定</button>
            </div>
            <div class="rating-keys">Enter 確定 · Esc 取消</div>
        </div>
    </div>
    <div class="lightbox-overlay" v-if="copyDialog" v-on:click.self="copyDialog = null">
        <div class="lightbox-overlay-content" style="background:#fff; color:#222; border-radius:8px; padding:14px 16px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <div style="font-weight:bold;">無法自動複製，請手動複製</div>
                <button type="button" class="btn btn-sm btn-outline-secondary" v-on:click="copyDialog = null"><i class="fa fa-times"></i></button>
            </div>
            <div style="font-size:13px; color:#888; margin-bottom:6px;">文字已全選：電腦按 Ctrl+C，手機長按後選「拷貝」。</div>
            <textarea id="copyDialogText" readonly rows="12" style="width:100%; font-size:14px;" v-model="copyDialog.text"></textarea>
        </div>
    </div>

