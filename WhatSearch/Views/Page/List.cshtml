                    <div style="font-size:1.2rem; font-weight:bold; word-break:break-all;">{{ musicFolder.title }}</div>
                    <div v-if="musicFolder.artist" style="color:#555;">{{ musicFolder.artist }}</div>
                    <div v-if="musicFolder.folderName && musicFolder.folderName !== musicFolder.title" style="color:#999; font-size:12px; word-break:break-all;">{{ musicFolder.folderName }}</div>
                    <div style="color:#888; font-size:13px; margin:4px 0 8px;">
