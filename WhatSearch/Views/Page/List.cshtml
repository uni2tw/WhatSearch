@using WhatSearch.Controllers
@using WhatSearch.Utilities
@{ 
    this.Layout = "_Layout.cshtml";
}

<style type="text/css">

    table {
        height: 100%;
    }

    .cell {
        background: #ddd;
        border: 5px solid #fff;
    }
    /* Optional */


    .stackem div {
        width: 100%;
    }

    .selected-item-row {
        border-left:0.75rem solid forestgreen;
    }
    .top-mark, .bottom-mark {
        color:transparent;
    }

    .nav-menu {
        position: relative;
    }
    .nav-menu .nav-icon-btn {
        position: relative;
    }
    /* 新上架：漢堡按鈕右上角的紅色未讀數字、選單項目後面的數字 */
    .news-badge {
        position: absolute;
        top: -6px;
        right: -6px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 9px;
        background: #dc3545;
        color: #fff;
        font-size: 11px;
        line-height: 18px;
        text-align: center;
        pointer-events: none;
    }
    .news-count {
        display: inline-block;
        margin-left: 8px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 9px;
        background: #dc3545;
        color: #fff;
        font-size: 11px;
        line-height: 18px;
        text-align: center;
        vertical-align: 1px;
    }
    .unplay-tag {
        display: inline-block;
        font-size: 11px;
        line-height: 16px;
        padding: 0 7px;
        margin-left: 6px;
        border-radius: 8px;
        background: #e9ecef;
        color: #6c757d;
        white-space: nowrap;
        vertical-align: 2px;
    }
    .media-hint {
        margin: 6px 5px 0;
        padding: 8px 12px;
        border-radius: 8px;
        background: #fff4e0;
        color: #7a4b00;
        font-size: 13px;
    }
    .media-hint .media-hint-detail {
        margin-top: 2px;
        font-size: 12px;
        color: #a67c3d;
    }
    .news-new {
        display: inline-block;
        font-size: 11px;
        line-height: 16px;
        padding: 0 7px;
        margin-left: 6px;
        border-radius: 8px;
        background: #fcebeb;
        color: #a32d2d;
        white-space: nowrap;
        vertical-align: 2px;
    }
    .ep-new {
        position: absolute;
        top: -6px;
        right: -4px;
        font-size: 10px;
        line-height: 14px;
        padding: 0 4px;
        border-radius: 7px;
        background: #dc3545;
        color: #fff;
        pointer-events: none;
    }
    .tc-badge {
        font-size: 11px;
        line-height: 14px;
        color: #999;
        white-space: nowrap;
    }
    .tc-badge.tc-pending { color: #b26a00; }
    .tc-badge.tc-failed { color: #c0392b; }
    .news-tabs {
        display: flex;
        gap: 6px;
        padding: 8px 0 4px;
    }
    .news-tab {
        flex: 1 1 0;
        padding: 6px 4px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #fff;
        color: #555;
        font-size: 13px;
        cursor: pointer;
    }
    .news-tab.active {
        background: #198754;
        border-color: #198754;
        color: #fff;
    }
    .news-day {
        padding: 8px 6px 4px;
        font-size: 12px;
        color: #888;
        background: #f7f7f7;
        margin: 0 -12px;
        padding-left: 18px;
    }
    .news-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 6px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
    }
    .news-unread {
        flex: 0 0 8px;
        width: 8px;
        height: 8px;
        margin-top: 13px;
        border-radius: 50%;
        background: #dc3545;
    }
    .news-unread.news-read {
        background: transparent;
    }
    .news-ico {
        flex: 0 0 34px;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }
    .news-ico-a { background: #e6f1fb; color: #185fa5; }
    .news-ico-m { background: #eeedfe; color: #534ab7; }
    .news-main {
        flex: 1 1 auto;
        min-width: 0;
    }
    .news-title {
        font-size: 16px;
        line-height: 20px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .news-title-read {
        color: #777;
    }
    .news-sub {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        font-size: 12px;
        color: #888;
        margin-top: 2px;
    }
    .nav-menu-dropdown {
        position: absolute;
        right: 0;
        top: calc(100% + 4px);
        background: #222;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.4);
        min-width: 140px;
        z-index: 1050;
        overflow: hidden;
    }
    .nav-menu-dropdown a, .nav-menu-dropdown button {
        display: block;
        width: 100%;
        text-align: left;
        padding: 8px 14px;
        font-size: 1rem;
        color: #fff;
        background: none;
        border: none;
        text-decoration: none;
    }
    .nav-menu-dropdown a:hover, .nav-menu-dropdown button:hover {
        background: #444;
        color: #fff;
    }

    .lightbox-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.85);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .lightbox-overlay-content {
        width: 100%;
        max-width: 960px;
        padding: 0 10px;
    }
    .lightbox-nav-btn {
        position: fixed;
        top: 50%;
        transform: translateY(-50%);
        z-index: 2001;
    }

    /* 字幕樣式：白字黑色描邊、無底框、粗體（接近動畫瘋的預設樣式） */
    video.player-video::cue {
        color: #fff;
        background-color: transparent;
        font-family: "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
        font-weight: 700;
        text-shadow: -1.5px -1.5px 0 #000, 1.5px -1.5px 0 #000, -1.5px 1.5px 0 #000, 1.5px 1.5px 0 #000,
                     0 0 4px rgba(0, 0, 0, 0.9);
    }

    /* 音樂資料夾（專輯）版面的歌曲列 */
    .track-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 6px;
        min-height: 52px;
        cursor: pointer;
        border-bottom: 1px solid #eee;
    }
    .track-no {
        flex: 0 0 28px;
        text-align: right;
        color: #999;
        font-size: 14px;
    }
    .track-main {
        flex: 1 1 auto;
        min-width: 0;
    }
    .track-title {
        font-size: 16px;
        line-height: 20px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .track-artist {
        font-size: 12px;
        color: #999;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .track-dur {
        flex: 0 0 auto;
        color: #999;
        font-size: 13px;
    }
    /* 最愛（愛心）按鈕：觸控範圍 44px，未收藏灰色空心、已收藏紅色實心 */
    .fav-btn {
        flex: 0 0 auto;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #bbb;
        font-size: 18px;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }
    .fav-btn.fav-on {
        color: #e0245e;
    }
    /* 星等評分：每顆星左半 / 右半各是一個點擊區（半顆星） */
    .rating-stars {
        display: inline-flex;
        align-items: center;
        gap: 0;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }
    .rstar {
        position: relative;
        width: 30px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #e0a800;
    }
    .rstar.rstar-off {
        color: #ccc;
    }
    /* 點星星＋分數這一塊會打開評分面板；範圍刻意只到星星旁邊，避免擋到「點整列進入資料夾」 */
    .rating-open {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        min-height: 36px;
        padding: 0 12px 0 0;
        cursor: pointer;
        -webkit-tap-highlight-color: rgba(0, 0, 0, 0.1);
    }
    /* 評分面板：手機（窄螢幕）是貼在畫面底部的面板；較寬的螢幕（桌機/平板）改成置中的對話框 */
    .rating-overlay {
        position: fixed;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 2500;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }
    .rating-sheet {
        background: #fff;
        width: 100%;
        max-width: 520px;
        border-radius: 16px 16px 0 0;
        padding: 14px 14px 18px;
        box-sizing: border-box;
    }
    .rating-keys {
        display: none;
        text-align: center;
        color: #999;
        font-size: 12px;
        margin-top: 10px;
    }
    @@media (min-width: 576px) {
        .rating-overlay {
            align-items: center;
        }
        .rating-sheet {
            width: 400px;
            max-width: calc(100% - 32px);
            border-radius: 14px;
            padding: 20px 22px 18px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
        }
        .rating-keys {
            display: block;
        }
    }
    .rating-open.rating-inline {
        align-self: auto;
        flex: 0 0 auto;
        min-height: 0;
        padding: 0 0 0 6px;
    }
    .rating-sheet-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }
    .rating-num {
        font-size: 13px;
        color: #888;
        margin-left: 6px;
        min-width: 28px;
    }
    .disc-header {
        padding: 12px 6px 4px;
        font-weight: bold;
        color: #555;
        border-bottom: 2px solid #ddd;
    }
    .track-playing .track-title,
    .track-playing .track-no {
        color: forestgreen;
        font-weight: bold;
    }

    .ep-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
    }
    .ep-btn {
        min-width: 56px;
        min-height: 44px;
        font-size: 1.1rem;
        font-weight: bold;
        position: relative;
    }
    .ep-btn.ep-selected {
        box-shadow: 0 0 0 3px forestgreen;
    }
    .ep-mark {
        font-size: 0.65rem;
        position: absolute;
        top: 3px;
        right: 4px;
    }
</style>

<body>

<div id="app" v-cloak>

    <nav class="navbar navbar-dark bg-dark sticky-top flex-nowrap">
        <div style="flex:1 1 0; display:flex; min-width:0">
            <span class="navbar-brand mb-0 h1 d-none d-sm-inline-block" style="flex:0 0 auto">WhatSearch</span>
            <div v-if="breadcrumbIsVisible" style="flex-grow:1; display:flex; min-width:0">
                <breadcrumbs-component :items="displayBreadcrumbs" :current-last="!videoGridVisible && !musicGridVisible"
                    v-on:select-breadcrumb="vm_getFolder"></breadcrumbs-component>
            </div>
            <template id="search-component" v-if="searchIsVisible">
                <div class="search-component-wrapper" style="position:relative; flex-grow: 1">
                    <input type="text" id="search-component-keyword" ref="myText" v-model="keyword"
                        v-on:keyup.enter="doSearch" 
                        v-on:click="$event.target.select()"
                        placeholder="什麼" class="form-control search-component-input" />
                    <button v-on:click="doSearch" class="btn btn-success"
                            style="position:absolute; right:0px; top:0px">
                        <i class="fa fa-search"></i>
                    </button>
                </div>
            </template>
        </div>
        <div style="display:flex; align-items:center; gap:6px; flex:0 0 auto; padding-left:2px">
            <button v-if="breadcrumbIsVisible" type="button" class="btn btn-outline-light nav-icon-btn" title="搜尋"
                v-on:click.stop="toggleBarMode()"><i class="fa fa-search"></i></button>
            <div class="nav-menu">
                <button v-on:click.stop="toggleMenu()" class="btn btn-success nav-icon-btn"><i class="fa fa-bars"></i><span v-if="newsUnread > 0" class="news-badge">{{ newsUnread > 99 ? '99+' : newsUnread }}</span></button>
                <div class="nav-menu-dropdown" v-if="menuOpen">
                    <button type="button" v-on:click.stop="vm_menuAction(toggleBarMode)">
                        <i class="fa fa-search"></i> 切換搜尋
                    </button>
                    <button v-if="newsEnabled" type="button" v-on:click.stop="vm_menuAction(vm_openNewsPage)">
                        <i class="fa fa-bell"></i> 新上架<span v-if="newsUnread > 0" class="news-count">{{ newsUnread > 99 ? '99+' : newsUnread }}</span>
                    </button>
                    <button v-if="nowPlaying.id && !inPlayingFolder" type="button" v-on:click.stop="vm_menuAction(vm_goPlayingFolder)">
                        <i class="fa fa-folder-open"></i> 回到播放中
                    </button>
                    <button v-if="isLoggedIn" type="button" v-on:click.stop="vm_menuAction(vm_showFavorites)">
                        <i class="fa-solid fa-heart"></i> 我的最愛
                    </button>
                    <a v-if="isLoggedIn" :href="logoutHref()"><i class="fa fa-sign-out-alt"></i> 登出</a>
                </div>
            </div>
        </div>
    </nav>
    
    <div class="container-fluid" :style="{ paddingBottom: nowPlaying.id ? '70px' : '0px', position: 'relative' }">
        <div v-if="loading" style="position:absolute; top:10px; left:0; width:100%; text-align:center; z-index:10; pointer-events:none;">
            <div class="spinner-border text-success" role="status" style="width:2rem; height:2rem;"></div>
        </div>
        <div v-if="notFound" style="padding:24px 12px;">
            <div style="font-size:1.15rem; font-weight:bold;"><i class="fa fa-folder-minus" style="color:#e0a800;"></i> 找不到這個資料夾</div>
            <div style="color:#888; font-size:13px; word-break:break-all; margin:6px 0 16px;">{{ notFound.requested }}</div>
            <div v-if="notFound.suggestions.length > 0" style="margin-bottom:16px;">
                <div style="margin-bottom:8px;">你是不是要找：</div>
                <div v-for="sg in notFound.suggestions" :key="sg.id" style="margin-bottom:8px;">
                    <button type="button" class="btn btn-outline-success"
                        style="text-align:left; max-width:100%; white-space:normal; word-break:break-all;"
                        v-on:click="vm_getFolder(sg.id, true)">
                        <i class="fa fa-folder-open"></i> {{ sg.title }}
                    </button>
                </div>
            </div>
            <div v-else style="color:#888; margin-bottom:16px;">沒有找到名稱相近的資料夾，可能被移動，或改成差異較大的名稱。</div>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <button type="button" class="btn btn-outline-secondary" v-on:click="vm_getFolder(notFound.nearest.id, true)">
                    <i class="fa fa-turn-up"></i> 回到上一層（{{ notFound.nearest.title }}）
                </button>
                <button v-if="notFound.lastFolder" type="button" class="btn btn-outline-secondary" v-on:click="vm_getFolder(notFound.lastFolder, true)">
                    <i class="fa fa-clock-rotate-left"></i> 回到上次看的資料夾
                </button>
            </div>
        </div>
        <div v-if="loadError" style="padding:24px 12px;">
            <div style="font-size:1.15rem; font-weight:bold;"><i class="fa fa-triangle-exclamation" style="color:#dc3545;"></i> {{ loadError }}</div>
            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:16px;">
                <button type="button" class="btn btn-outline-success" v-on:click="vm_getFolder(loadErrorFolder, false)">
                    <i class="fa fa-rotate-right"></i> 重試
                </button>
            </div>
        </div>
        <div v-if="newsView" style="padding:2px 12px 0;">
            <div class="news-tabs">
                <button v-for="r in newsRangeTabs" :key="r.days" type="button" class="news-tab" :class="{active: newsRange === r.days}" v-on:click="vm_setNewsRange(r.days)">{{ r.days }} 天內 ({{ r.count }})</button>
            </div>
            <div v-if="newsFiltered.length === 0 && !loading" style="padding:32px 16px; text-align:center; color:#888;">{{ newsRange }} 天內沒有新上架。</div>
            <template v-for="g in newsGroups" :key="g.label">
                <div class="news-day">{{ g.label }}</div>
                <div v-for="e in g.items" :key="e.id" class="news-row" v-on:click="vm_openNews(e)">
                    <span class="news-unread" :class="{'news-read': !e.unread}"></span>
                    <span class="news-ico" :class="e.kind === 'album' ? 'news-ico-m' : 'news-ico-a'"><i :class="e.kind === 'album' ? 'fa fa-compact-disc' : 'fa fa-film'"></i></span>
                    <div class="news-main">
                        <div class="news-title" :class="{'news-title-read': !e.unread}">{{ e.title }}</div>
                        <div class="news-sub"><span>{{ vm_newsLabel(e) }}</span><span>{{ vm_newsTime(e.time) }}</span></div>
                    </div>
                </div>
            </template>
        </div>
        <div v-if="currentRating" style="padding:6px 5px 0; display:flex; align-items:center; flex-wrap:wrap; gap:4px 10px;">
            <span style="font-size:14px; color:#555;">我的評分</span>
            <span class="rating-open" v-on:click.stop="vm_openCurrentRating()">
                <span class="rating-stars">
                    <span v-for="n in 5" :key="n" class="rstar" :class="{'rstar-off': !(currentRating.rating >= n - 0.5)}">
                        <i :class="vm_starClass(currentRating.rating, n)"></i>
                    </span>
                </span>
                <span class="rating-num">{{ currentRating.rating > 0 ? currentRating.rating : '未評分' }}</span>
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" v-on:click="vm_copyCurrentRating()">
                <i class="fa fa-copy"></i> 複製
            </button>
        </div>
        <div v-if="currentRating && currentRating.kind === 'anime' && currentRating.unplayable" style="padding:6px 5px 0; display:flex; align-items:center; flex-wrap:wrap; gap:6px 10px;">
            <span class="unplay-tag" style="margin-left:0;"><i class="fa fa-ban"></i> 無法播放</span>
            <span style="font-size:12px; color:#888;">管理者已標註這部可能無法播放（{{ currentRating.unplayable_by }}，{{ vm_unplayDate(currentRating.unplayable_time) }}），仍可點進去試播</span>
            <button v-if="isAdmin" type="button" class="btn btn-sm btn-outline-secondary" v-on:click="vm_toggleUnplayable()">
                <i class="fa fa-rotate-left"></i> 取消無法播放
            </button>
        </div>
        <div v-if="mediaHintWarnings.length > 0" class="media-hint" style="display:flex; align-items:flex-start; gap:10px;">
            <div style="flex:1 1 auto; min-width:0;">
                <i class="fa fa-triangle-exclamation"></i> 你的瀏覽器可能無法正常播放這部：{{ mediaHintWarnings.join('；') }}
                <div class="media-hint-detail">{{ mediaHintDetail }}（這是依你目前的瀏覽器判斷的提示，仍可點進去試播）</div>
            </div>
            <button v-if="isAdmin && currentRating && currentRating.kind === 'anime' && !currentRating.unplayable" type="button" class="btn btn-sm btn-outline-danger"
                style="flex:0 0 auto; white-space:nowrap;" title="確認這部無法播放，標註給所有人看" v-on:click="vm_toggleUnplayable()">
                <i class="fa fa-ban"></i> 無法播放
            </button>
        </div>
        <div v-if="videoGridVisible" style="padding:10px 5px;">
            <div style="display:flex; gap:14px; align-items:flex-start;">
                <div v-if="videoCoverUrl" style="flex:0 0 auto; width:140px;">
                    <img :src="videoCoverUrl" style="width:100%; border-radius:6px; display:block;" />
                </div>
                <div style="flex:1; min-width:0;">
                    <div style="font-size:1.2rem; font-weight:bold; word-break:break-all;">{{ videoFolder.title }}</div>
                    <div style="color:#888; font-size:13px; margin:4px 0 8px;">
                        共 {{ videoFolder.episodes.length }} 集<span v-if="videoFolder.quality"> · {{ videoFolder.quality }}</span> · 已看 {{ watchedCount }}
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" v-on:click="showListView = true">切換列表檢視</button>
                </div>
            </div>
            <div class="ep-grid">
                <button v-for="ep in videoFolder.episodes" :key="ep.item.id" type="button" class="ep-btn btn"
                    :class="[vm_epClass(ep), {'ep-selected': ep.item.selected}]"
                    :style="vm_epStyle(ep)"
                    v-on:click="vm_changeFolder(ep.item)">
                    {{ ep.label }}<i v-if="vm_epState(ep.item.id) === 'watched'" class="fa fa-check ep-mark"></i><span v-if="ep.item.news_kind" class="ep-new">新</span>
                </button>
            </div>
        </div>
        <div v-if="singleVideo && !videoFolder && videoCoverUrl" style="padding:10px 5px; display:flex; gap:14px; align-items:flex-start;">
            <div style="flex:0 0 auto; width:140px; cursor:pointer;" v-on:click="vm_changeFolder(singleVideo)">
                <img :src="videoCoverUrl" style="width:100%; border-radius:6px; display:block;" />
            </div>
            <div style="flex:1; min-width:0;">
                <div style="font-size:1.1rem; font-weight:bold; word-break:break-all;">{{ singleVideo.title }}</div>
                <div style="color:#888; font-size:13px; margin:4px 0 8px;">
