            <i class="fa fa-chevron-left"></i>
        </button>
        <div class="lightbox-overlay-content">
            <div style="display:flex; justify-content:space-between; align-items:center; color:#fff; padding:6px 2px;">
                <div style="overflow:hidden; white-space:nowrap; text-overflow:ellipsis; margin-right:10px;">{{ previewImage.title }}</div>
                <button type="button" class="btn btn-sm btn-outline-light" v-on:click="vm_closeImagePreview()">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <img :src="previewImage.url" style="width:100%; max-height:80vh; object-fit:contain; background:#000;" />
        </div>
        <button type="button" class="btn btn-outline-light lightbox-nav-btn" style="right:10px"
            v-if="previewImage.hasNext" v-on:click="vm_previewStep(1)">
            <i class="fa fa-chevron-right"></i>
        </button>
    </div>

    <div class="lightbox-overlay" v-if="previewText.id" v-on:click.self="vm_closeTextPreview()">
        <div class="lightbox-overlay-content" style="background:#fff; color:#222; border-radius:8px; max-height:85vh; overflow:auto; padding:16px 20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <div style="font-weight:bold; font-size:1.1rem; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; margin-right:10px;">{{ previewText.title }}</div>
                <button type="button" class="btn btn-sm btn-outline-secondary" v-on:click="vm_closeTextPreview()">
