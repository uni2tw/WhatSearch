                    });
                },
                // 還有單曲在背景分析響度時，每 4 秒更新一次；只就地更新響度欄位，不重建清單（保留播放中的標示與佇列）
                vm_scheduleFavPoll: function () {
                    if (this.favPollTimer) {
                        clearTimeout(this.favPollTimer);
                        this.favPollTimer = null;
                    }
                    if (!this.favView || this.favPending <= 0) {
                        return;
                    }
                    this.favPollTimer = setTimeout(() => {
                        this.favPollTimer = null;
                        if (!this.favView) {
                            return;
                        }
                        api.favoriteItems().then(res => {
                            let byId = {};
                            res.data.items.forEach(x => { byId[x.id] = x; });
                            this.allItems.forEach(it => {
                                let n = byId[it.id];
                                if (n && it.type === 'music') {
                                    it.loudness = n.loudness;
                                    it.gain_db = n.gain_db;
                                    it.loudness_state = n.loudness_state;
                                }
                            });
                            this.favPending = res.data.pending || 0;
                            this.vm_scheduleFavPoll();
                        }).catch(() => {
                            this.vm_scheduleFavPoll();
                        });
                    }, 4000);
                },
                vm_loudnessText: function (item) {
                    if (item.loudness_state === 'ready') {
                        let g = item.gain_db;
                        return item.loudness + ' LUFS · 調整 ' + (g > 0 ? '+' : '') + g + ' dB' + (this.loudnessOn ? '' : '（音量平衡已關閉）');
                    }
                    if (item.loudness_state === 'pending') {
                        return '分析音量中…';
                    }
                    if (item.loudness_state === 'unsupported') {
                        return '只支援 MP3 的音量平衡（維持原音量）';
                    }
                    return '無法分析音量（維持原音量）';
                },
                // 播放單曲時套用音量平衡：只有從「我的最愛」單曲分頁開始的佇列才會用；其他情況增益為 0 dB。
                // Web Audio 的 GainNode 在需要時才建立（建立前完全不碰 Web Audio），之後維持接在播放元件上
                vm_ensureAudioGraph: function () {
                    if (this.gainNode) {
                        return true;
                    }
                    if (this.audioGraphFailed || !window.audio) {
                        return false;
                    }
                    let AC = window.AudioContext || window.webkitAudioContext;
                    if (!AC) {
                        this.audioGraphFailed = true;
                        return false;
                    }
                    try {
                        let ctx = new AC();
                        let source = ctx.createMediaElementSource(window.audio);
                        let gain = ctx.createGain();
                        source.connect(gain);
                        gain.connect(ctx.destination);
                        this.audioCtx = ctx;
                        this.gainNode = gain;
                        // iOS 17+：讓這個頁面的音訊視為「播放」類別，不被靜音開關靜音
                        if ('audioSession' in navigator) {
                            try { navigator.audioSession.type = 'playback'; } catch (e) { }
                        }
                        return true;
                    } catch (e) {
                        console.log('web audio setup failed', e);
                        this.audioGraphFailed = true;
                        return false;
                    }
                },
                vm_applyTrackGain: function (id) {
                    let item = this.playQueue.find(t => t.id === id) || this.items.find(t => t.id === id);
                    let db = (this.playQueueGain && this.loudnessOn && item && typeof item.gain_db === 'number') ? item.gain_db : 0;
                    // 從「我的最愛」單曲佇列開始播放時（使用者剛點了一首歌）就先建立 Web Audio，
                    // 之後自動接播的歌曲不是使用者手勢，那時才建立的話 iOS 會讓 AudioContext 停在 suspended 而沒有聲音
                    if (!this.gainNode && !(this.playQueueGain && this.loudnessOn)) {
                        return;
                    }
                    if (!this.vm_ensureAudioGraph()) {
                        return;
                    }
                    this.trackGain = Math.pow(10, db / 20);
                    let g = this.gainNode.gain;
                    g.cancelScheduledValues(this.audioCtx.currentTime);
                    g.setTargetAtTime(this.trackGain, this.audioCtx.currentTime, 0.015);
                    if (this.audioCtx.state === 'suspended') {
                        this.audioCtx.resume().catch(() => { });
                    }
                },
                // 暫停前先在約 30ms 內把音量降到 0 再暫停（避免暫停當下的殘音與爆音）；繼續時還原
                // 換歌後，如果正在播的那一列不在可視範圍（或被上方導覽列／底部播放列遮住），平滑捲到畫面中間；已經看得到就不動。
                // 只在目前畫面就是播放中的資料夾時處理，而且使用者 8 秒內自己捲動過就不自動捲
                vm_scrollToPlaying: function () {
                    if (Date.now() - this.lastUserScrollAt < 8000) {
                        return;
                    }
                    window.setTimeout(() => {
                        this.$nextTick(() => {
                            if (!this.inPlayingFolder) {
                                return;
                            }
                            let el = document.querySelector('.track-playing') || document.querySelector('.selected-item-row');
                            if (!el) {
                                return;
                            }
                            let nav = document.querySelector('nav.navbar');
                            let bar = document.querySelector('.now-playing-bar');
                            let topLimit = nav ? nav.getBoundingClientRect().bottom : 0;
                            let bottomLimit = bar ? bar.getBoundingClientRect().top : window.innerHeight;
                            let r = el.getBoundingClientRect();
                            if (r.top >= topLimit && r.bottom <= bottomLimit) {
                                return;
                            }
                            let target = window.scrollY + r.top - (topLimit + (bottomLimit - topLimit - r.height) / 2);
                            window.scrollTo({ top: Math.max(0, target), behavior: 'smooth' });
                        });
                    }, 150);
                },
                vm_albumPlayClick: function () {
                    if (!this.musicFolder) {
                        return;
                    }
                    let state = this.albumPlayState;
                    if (state === 'resume') {
                        this.vm_audioPlay();
                    } else if (state === 'pause') {
                        this.vm_audioPause();
                    } else {
                        this.vm_changeFolder(this.musicFolder.tracks[0].item);
                    }
                },
                vm_audioPause: function () {
                    let a = window.audio;
                    if (!a) {
                        return;
                    }
                    this.audioIntent = 'pause';
                    this.audioInterruptedAt = 0;
                    this.resumeHint = false;
                    let token = ++this.pauseToken;
                    if (this.gainNode && this.audioCtx && this.audioCtx.state === 'running') {
                        let g = this.gainNode.gain;
                        g.cancelScheduledValues(this.audioCtx.currentTime);
                        g.setTargetAtTime(0, this.audioCtx.currentTime, 0.008);
                        setTimeout(() => {
                            if (this.pauseToken === token) {
                                a.pause();
                            }
                        }, 40);
                    } else {
                        a.pause();
                    }
                },
                vm_audioPlay: function () {
                    let a = window.audio;
                    if (!a) {
                        return;
                    }
                    this.audioIntent = 'play';
                    this.pauseToken++;
                    if (this.gainNode && this.audioCtx) {
                        let g = this.gainNode.gain;
                        g.cancelScheduledValues(this.audioCtx.currentTime);
                        g.setTargetAtTime(this.trackGain, this.audioCtx.currentTime, 0.015);
                        if (this.audioCtx.state === 'suspended') {
                            this.audioCtx.resume().catch(() => { });
                        }
                    }
                    let p = a.play();
                    if (p && p.catch) {
                        p.catch(() => { });
                    }
                    return p;
                },
                // 被別的 App 打斷後回到這個頁面：自動繼續播放；瀏覽器不讓（常見於 iPhone）就提示點一下播放鍵。超過 30 分鐘不自動繼續
                vm_tryResumeAfterInterruption: function () {
                    let a = window.audio;
                    if (!a || this.audioInterruptedAt === 0) {
                        return;
                    }
                    if (this.audioIntent !== 'play' || a.paused === false || a.ended) {
                        this.audioInterruptedAt = 0;
                        this.resumeHint = false;
                        return;
                    }
                    if (Date.now() - this.audioInterruptedAt > 30 * 60 * 1000) {
                        this.audioInterruptedAt = 0;
                        return;
                    }
                    let p = this.vm_audioPlay();
                    if (p && p.then) {
                        p.then(() => {
                            this.audioInterruptedAt = 0;
                            this.resumeHint = false;
                        }).catch(() => {
                            this.resumeHint = true;
                        });
                    }
                },
                vm_canFav: function (item) {
                    return this.isLoggedIn === true && (item.type === 'music' || (this.favView && item.type === 'folder'));
                },
                vm_isFav: function (item) {
                    return !!(item.type === 'folder' ? this.favAlbumMap[item.id] : this.favTrackMap[item.id]);
                },
                // 樂觀更新：先改畫面，伺服器失敗再還原
                vm_toggleFav: function (kind, id) {
                    if (!id) {
                        return;
                    }
                    let map = kind === 'album' ? this.favAlbumMap : this.favTrackMap;
                    let want = !map[id];
                    if (want) { map[id] = true; } else { delete map[id]; }
                    api.setFavorite(kind, id, want).catch(err => {
                        if (want) { delete map[id]; } else { map[id] = true; }
                        let st = err && err.response ? err.response.status : 0;
                        if (st === 401) {
                            this.redirectToLogin('');
                        } else if (st === 404) {
                            alert('找不到這個項目，可能已改名或刪除');
                        } else {
                            alert('更新最愛失敗，請稍後再試');
                        }
                    });
                },
                // 資料夾不存在（例如改過名）：顯示「找不到」畫面；不更新網址、也不覆蓋「上次看的資料夾」
                vm_showNotFound: function (data, requestedId) {
                    this.favView = false;
                    this.newsView = false;
                    this.currentRating = null;
                    this.allItems = [];
                    this.discGroups = null;
                    this.activeFilter = null;
                    this.breadcrumbs = data.breadcrumbs;
                    this.footerMessage = '';
                    this.searchIsVisible = false;
                    this.breadcrumbIsVisible = true;
                    this.loadError = '';
                    let last = '';
                    try { last = window.localStorage.getItem('lastFolder') || ''; } catch (e) { }
                    this.notFound = {
                        requested: data.requested,
                        nearest: data.nearest,
                        suggestions: data.suggestions || [],
                        lastFolder: (last && last !== requestedId) ? last : ''
                    };
                },
                vm_getFolder: function (folder, pushState, revealPlaying) {
                    this.loading = true;
                    api.folder(folder).then((res) => {
                        var data = res.data;
                        if (data.notFound) {
                            this.vm_showNotFound(data, folder);
                            return;
                        }
                        if (history.state != null) {
                            console.log('url from:' + history.state.url);
                        }
                        console.log('url to:' + data.url);

                        if (pushState) {
                            let state = { 'folder': folder };
                            console.log('push-state:' + folder);
                            window.history.pushState(state, '', data.url);
                        }
                        let lastFolder = window.localStorage.getItem('lastFolder');                        
                        this.vm_renderItems(data);
                        if (revealPlaying) {
                            this.vm_revealPlaying();
                        }
                        window.localStorage.setItem('lastFolder', folder); 
                        if (lastFolder) {
                            let lastFolderFoundIndex = -1;
                            let lastFolderFoundItem = -1;
                            for(var i in data.items) {
                                let item = data.items[i];                                
                                if (item.id == lastFolder) {
                                    lastFolderFoundIndex = i;
                                    lastFolderFoundItem = item;
                                    break;
                                }
                            }
                            if (lastFolderFoundIndex != -1) {
                                lastFolderFoundItem.selected = true;
                                //Vue.set(data.items, lastFolderFoundIndex, lastFolderFoundItem);
                            }
                        }
                    }).catch(err => {
                        let st = (err && err.response) ? err.response.status : '網路錯誤';
                        this.favView = false;
                        this.newsView = false;
                        this.currentRating = null;
                        this.allItems = [];
                        this.discGroups = null;
                        this.notFound = null;
                        this.footerMessage = '';
                        this.loadError = '載入資料夾失敗（' + st + '），請稍後再試。';
                        this.loadErrorFolder = folder;
                    }).finally(() => {
                        this.loading = false;
                    })
                },
                vm_changeFolder: function (item) {
                    if (item.type == 'folder') {
                        this.vm_getFolder(item.id, true);
                    } else {
                        if ((item.type == 'music' || item.type == 'video') && this.isLoggedIn === false) {
                            console.log('not logged in, redirect to login');
                            this.redirectToLogin(item.id);
                            return;
                        }
                        if (item.type == 'music') {
                            console.log('play music:' + item.get_url);
                            // 佇列 = 目前清單裡的音樂，從被點的這首開始；是否接播由「自動下一首」「播完重頭開始」決定
                            let musicItems = this.musicGridVisible
                                ? this.musicFolder.tracks.map(t => t.item)
                                : this.items.filter(t => t.type === 'music');
                            let idx = musicItems.findIndex(t => t.id === item.id);
                            this.playQueue = idx === -1 ? [item] : musicItems;
                            this.playQueueIndex = idx === -1 ? 0 : idx;
                            this.playQueueGain = this.favView && this.favTab === 'track';
                            this.playCoverUrl = (this.musicGridVisible && this.videoCoverUrl)
                                ? this.videoCoverUrl
                                : this.vm_findCoverUrl(musicItems);
                            this.vm_playMusic(item.get_url, item.id);
                        } else if (item.type == 'video') {
                            console.log('play video:' + item.get_url);
                            this.vm_playVideo(item);
                        } else if (item.type == 'image') {
                            console.log('preview image:' + item.get_url);
                            this.vm_previewImage(item);
                        } else if (item.type == 'text') {
                            console.log('preview text:' + item.get_url);
                            this.vm_previewText(item);
                        } else {
                            console.log('open file:' + item.get_url);
                            window.open(item.get_url, '_blank');
                        }
                    }
                },
                vm_playVideo: function (item) {
                    if (document.activeElement && document.activeElement.blur) {
                        document.activeElement.blur();
                    }
                    this.vm_saveCurrentVideoProgress();
                    if (window.audio && !window.audio.paused) {
                        this.audioIntent = 'pause';
                        window.audio.pause();
                    }
                    this.setSelectedItem(item.id);
                    let ep = null;
                    let videoItems;
                    if (this.videoFolder) {
                        videoItems = this.videoFolder.episodes.map(e => e.item);
                        ep = this.videoFolder.episodes.find(e => e.item.id === item.id) || null;
                    } else {
                        videoItems = this.items.filter(t => t.type === 'video');
                    }
                    let idx = videoItems.findIndex(t => t.id === item.id);
                    let nextItem = (idx !== -1 && idx < videoItems.length - 1) ? videoItems[idx + 1] : null;
                    let prevItem = idx > 0 ? videoItems[idx - 1] : null;
                    // 換集時瀏覽器會自行切換字幕軌，等 loadedmetadata 套用完字幕再開始記錄使用者的選擇
                    this.subtitleIgnoreUntil = Number.MAX_SAFE_INTEGER;
                    this.nowPlayingVideo = {
                        id: item.id,
                        title: item.title,
                        label: ep ? ep.label : '',
                        url: item.get_url,
                        coverApi: this.vm_coverApiUrl(item),
                        bytes: item.bytes || 0,
                        duration: item.duration || 0,
                        subtitles: this.vm_findSubtitles(item),
                        error: '',
                        ended: false,
                        hasNext: !!nextItem,
                        nextItem: nextItem,
                        prevItem: prevItem
                    };
                    this.vm_updateVideoMediaSession();
                    this.vm_loadEmbeddedSubtitles(item);
                    this.vm_clearStall();
                    this.$nextTick(() => { this.vm_hookVideoStall(this.$refs.videoEl); });
                },
                // MKV 內嵌的文字字幕軌（由伺服器解析）：查到後加進字幕選單
                vm_loadEmbeddedSubtitles: function (item) {
                    if (!/\.mkv$/i.test(item.title)) {
                        return;
                    }
                    let id = item.id;
                    let base = item.get_url + (item.get_url.indexOf('?') === -1 ? '?' : '&');
                    axios.get(base + 'subtitleTracks=true').then(res => {
                        let tracks = (res.data && res.data.tracks) || [];
                        if (tracks.length === 0 || this.nowPlayingVideo.id !== id) {
                            return;
                        }
                        let added = tracks.map(t => {
                            let lang = this.vm_embeddedLang(t);
                            return {
                                url: base + 'subtitle=true&track=' + t.number,
                                label: lang.label + ' (內嵌)',
                                srclang: lang.srclang,
                                order: lang.order
                            };
                        });
                        let merged = this.nowPlayingVideo.subtitles.concat(added);
                        merged.sort((a, b) => a.order - b.order || a.label.localeCompare(b.label));
                        let seen = {};
                        merged.forEach(s => {
                            seen[s.label] = (seen[s.label] || 0) + 1;
                            if (seen[s.label] > 1) {
                                s.label += ' ' + seen[s.label];
                            }
                        });
                        // 新增字幕軌時瀏覽器會自行切換，先暫停記錄使用者選擇，套用完再恢復
                        this.subtitleIgnoreUntil = Number.MAX_SAFE_INTEGER;
                        this.nowPlayingVideo.subtitles = merged;
                        this.$nextTick(() => {
                            let v = this.$refs.videoEl;
                            if (v && this.nowPlayingVideo.id === id) {
                                this.vm_applySubtitleTracks(v);
                            }
                        });
                    }).catch(() => { });
                },
                vm_embeddedLang: function (t) {
                    let n = (t.name || '').toLowerCase();
                    let l = (t.language || '').toLowerCase();
                    if (/繁|cht|big5|traditional|zh[-_]?(tw|hant|hk)|\btc\b/.test(n) || /^zh[-_]?(tw|hant|hk)/.test(l)) {
                        return { label: '繁體中文', srclang: 'zh-TW', order: 0 };
                    }
                    if (/簡|简|chs|\bgb|simplified|zh[-_]?(cn|hans)|\bsc\b/.test(n) || /^zh[-_]?(cn|hans)/.test(l)) {
                        return { label: '簡體中文', srclang: 'zh-CN', order: 1 };
                    }
                    if (/^(chi|zho|zh|cmn)/.test(l)) {
                        return { label: '中文', srclang: 'zh', order: 2 };
                    }
                    if (/^(eng|en)/.test(l)) {
                        return { label: 'English', srclang: 'en', order: 3 };
                    }
                    if (/^(jpn|ja)/.test(l)) {
                        return { label: '日本語', srclang: 'ja', order: 4 };
                    }
                    return { label: t.name || t.language || '字幕', srclang: 'und', order: 6 };
                },
                vm_closeVideo: function () {
                    this.vm_saveCurrentVideoProgress();
                    this.vm_clearStall();
                    this.nowPlayingVideo = { id: null, title: '', label: '', url: '', coverApi: '', bytes: 0, duration: 0, subtitles: [], error: '', ended: false, hasNext: false, nextItem: null, prevItem: null };
                    this.vm_restoreAudioMediaSession();
                },
                // 同資料夾、同主檔名（可多一段語言標記）的 .srt/.vtt/.ass/.ssa 視為這部影片的外掛字幕
                vm_findSubtitles: function (item) {
                    if (this.allItems.some(t => t.path)) {
                        return [];
                    }
                    let base = item.title.replace(/\.[^.]+$/, '').toLowerCase();
                    let exts = ['.srt', '.vtt', '.ass', '.ssa'];
                    let found = [];
                    this.allItems.forEach(t => {
                        let name = t.title.toLowerCase();
                        let ext = exts.find(e => name.endsWith(e));
                        if (!ext) {
                            return;
                        }
                        let noExt = name.slice(0, name.length - ext.length);
                        let tag;
                        if (noExt === base) {
                            tag = '';
                        } else if (noExt.startsWith(base + '.')) {
                            tag = noExt.slice(base.length + 1);
                        } else {
                            return;
                        }
                        let lang = this.vm_subtitleLang(tag);
                        found.push({
                            url: t.get_url + (t.get_url.indexOf('?') === -1 ? '?' : '&') + 'subtitle=true',
                            label: lang.label,
                            srclang: lang.srclang,
                            order: lang.order,
                            ext: ext
                        });
                    });
                    found.sort((a, b) => a.order - b.order || a.label.localeCompare(b.label));
                    found.forEach(f => {
                        if (found.filter(o => o.label === f.label).length > 1) {
                            f.label += ' (' + f.ext + ')';
                        }
                    });
                    return found;
                },
                vm_subtitleLang: function (tag) {
                    if (!tag) {
                        return { label: '字幕', srclang: 'und', order: 5 };
                    }
                    if (/^(zh[-_]?(tw|hant|hk|mo)|cht|tc|big5|繁體?|繁中)$/.test(tag)) {
                        return { label: '繁體中文', srclang: 'zh-TW', order: 0 };
                    }
                    if (/^(zh[-_]?(cn|hans|sg)|chs|sc|gb|gbk|簡體?|简体?|簡中|简中)$/.test(tag)) {
                        return { label: '簡體中文', srclang: 'zh-CN', order: 1 };
                    }
                    if (/^(zh|chi|chinese|中文)$/.test(tag)) {
                        return { label: '中文', srclang: 'zh', order: 2 };
                    }
                    if (/^(en|eng|english)$/.test(tag)) {
                        return { label: 'English', srclang: 'en', order: 3 };
                    }
                    if (/^(ja|jp|jpn|japanese|日語|日文|日本語)$/.test(tag)) {
                        return { label: '日本語', srclang: 'ja', order: 4 };
                    }
                    return { label: tag, srclang: 'und', order: 6 };
                },
                // 依上次選擇（含「關閉」）決定顯示哪一軌字幕，沒有紀錄就顯示第一軌（繁體優先）
                vm_applySubtitleTracks: function (v) {
                    let tracks = v.textTracks;
                    let subs = this.nowPlayingVideo.subtitles || [];
                    if (!tracks || tracks.length === 0) {
                        return;
                    }
                    let pref = null;
                    try { pref = window.localStorage.getItem('subtitlePref'); } catch (e) { }
                    let showIdx = 0;
                    if (pref === '__off') {
                        showIdx = -1;
                    } else if (pref) {
                        let i = subs.findIndex(s => s.label === pref);
                        if (i !== -1) {
                            showIdx = i;
                        }
                    }
                    this.subtitleIgnoreUntil = Date.now() + 800;
                    for (let i = 0; i < tracks.length; i++) {
                        tracks[i].mode = (i === showIdx) ? 'showing' : 'disabled';
                    }
                    this.subtitleIndex = showIdx;
                    if (!v._subtitleHooked) {
                        v._subtitleHooked = true;
                        tracks.addEventListener('change', () => {
                            if (Date.now() < this.subtitleIgnoreUntil) {
                                return;
                            }
                            // 使用者從瀏覽器原生字幕選單切換：同步下拉選單並記住選擇
                            let shown = -1;
                            for (let i = 0; i < tracks.length; i++) {
                                if (tracks[i].mode === 'showing') {
                                    shown = i;
                                }
                            }
                            this.subtitleIndex = shown;
                            try {
                                window.localStorage.setItem('subtitlePref', shown === -1 ? '__off' : tracks[shown].label);
                            } catch (e) { }
                        });
                    }
                },
                // 疊層上的字幕下拉選單：-1 = 關閉
                vm_pickSubtitle: function (value) {
                    let idx = parseInt(value, 10);
                    let v = this.$refs.videoEl;
                    if (!v || isNaN(idx)) {
                        return;
                    }
                    for (let i = 0; i < v.textTracks.length; i++) {
                        v.textTracks[i].mode = (i === idx) ? 'showing' : 'disabled';
                    }
                    this.subtitleIndex = idx;
                    let sub = this.nowPlayingVideo.subtitles[idx];
                    try {
                        window.localStorage.setItem('subtitlePref', (idx === -1 || !sub) ? '__off' : sub.label);
                    } catch (e) { }
                },
                vm_videoLoaded: function (evt) {
                    let v = evt.target;
                    v.playbackRate = this.videoRate;
                    this.vm_applySubtitleTracks(v);
                    let p = this.videoProgress[this.nowPlayingVideo.id];
                    if (p && !p.w && p.t > 5 && p.t < v.duration - 5) {
                        v.currentTime = p.t;
                    }
                },
                vm_videoTimeUpdate: function (evt) {
                    let vd = evt.target.duration;
                    if ('mediaSession' in navigator && navigator.mediaSession.setPositionState && isFinite(vd) && vd > 0) {
                        try {
                            navigator.mediaSession.setPositionState({
                                duration: vd,
                                position: Math.min(evt.target.currentTime, vd),
                                playbackRate: evt.target.playbackRate || 1
                            });
                        } catch (e) { }
                    }
                    if (Date.now() - this.videoSaveAt < 5000) {
                        return;
                    }
                    this.videoSaveAt = Date.now();
                    this.vm_saveProgress(this.nowPlayingVideo.id, evt.target.currentTime, evt.target.duration, false);
                },
                vm_videoPause: function (evt) {
                    this.vm_saveProgress(this.nowPlayingVideo.id, evt.target.currentTime, evt.target.duration, false);
                },
                // ---- 播放卡住偵測：載入/緩衝超過 8 秒仍沒開始播放，顯示提示並回報伺服器（寫進伺服端日誌）----
                vm_hookVideoStall: function (v) {
                    if (!v || v._stallHooked) {
                        return;
                    }
                    v._stallHooked = true;
                    let self = this;
                    ['loadstart', 'waiting', 'stalled'].forEach(n => v.addEventListener(n, function () { self.vm_armStallTimer(v); }));
                    ['playing', 'canplaythrough', 'emptied'].forEach(n => v.addEventListener(n, function () { self.vm_clearStall(); }));
                },
                vm_armStallTimer: function (v) {
                    if (this.stallTimer || this.nowPlayingVideo.error) {
                        return;
                    }
                    let startBuffered = this.vm_bufferedTotal(v);
                    let startAt = Date.now();
                    this.stallTimer = setTimeout(() => {
                        this.stallTimer = null;
                        this.vm_showStallHint(v, startBuffered, Date.now() - startAt);
                    }, this.stallHintMs);
                },
                vm_clearStall: function () {
                    if (this.stallTimer) {
                        clearTimeout(this.stallTimer);
                        this.stallTimer = null;
                    }
                    this.videoSlowHint = '';
                },
                vm_bufferedTotal: function (v) {
                    let total = 0;
                    for (let i = 0; i < v.buffered.length; i++) {
                        total += v.buffered.end(i) - v.buffered.start(i);
                    }
                    return total;
                },
                vm_showStallHint: function (v, startBuffered, elapsedMs) {
                    let nv = this.nowPlayingVideo;
                    // 資料已經足夠（正在播放，或使用者自己暫停）就不算卡住；
                    // 注意 autoplay 的影片在資料到齊前 paused 本來就是 true，所以不能用 paused 判斷
                    if (!nv.id || nv.error || v.readyState >= 3) {
                        return;
                    }
                    let secs = Math.round(elapsedMs / 1000);
                    let total = this.vm_bufferedTotal(v);
                    let gained = total - startBuffered;
                    let mbps = (nv.bytes && nv.duration) ? nv.bytes * 8 / nv.duration / 1000000 : 0;
                    let est = (mbps && elapsedMs > 0) ? gained * mbps / (elapsedMs / 1000) : null;
                    let lines = ['影片載入很慢（已等待 ' + secs + ' 秒，已緩衝 ' + total.toFixed(1) + ' 秒）'];
                    if (mbps) {
                        lines.push('影片平均約 ' + mbps.toFixed(1) + ' Mbps' +
                            (est !== null ? '，目前實際下載約 ' + est.toFixed(1) + ' Mbps' : '') +
                            '；下載速度低於影片位元率就會一直轉圈');
                    } else {
                        lines.push('可能是連線速度不足');
                    }
                    if (/iPhone|iPad/.test(navigator.userAgent) && /\.mkv$/i.test(nv.title)) {
                        lines.push('iPhone Safari 不支援 MKV');
                    }
                    this.videoSlowHint = lines.join('。');
                    let can = t => v.canPlayType(t) || 'no';
                    this.vm_reportPlayDiag('stall',
                        'readyState=' + v.readyState + ' networkState=' + v.networkState +
                        ' buffered=' + total.toFixed(1) + 's gained=' + gained.toFixed(1) + 's elapsed=' + secs + 's' +
                        ' bitrate=' + (mbps ? mbps.toFixed(2) + 'Mbps' : '?') +
                        ' est=' + (est !== null ? est.toFixed(2) + 'Mbps' : '?') +
                        ' time=' + v.currentTime.toFixed(1) + '/' + (isFinite(v.duration) ? v.duration.toFixed(0) : '?') +
                        ' size=' + v.videoWidth + 'x' + v.videoHeight +
                        ' h264=' + can('video/mp4; codecs="avc1.640028, mp4a.40.2"') +
                        ' hevc=' + can('video/mp4; codecs="hvc1.1.6.L120.90, mp4a.40.2"'));
                },
                // 回報給伺服器寫進日誌（30 秒內最多一次，失敗不影響播放）
                vm_reportPlayDiag: function (evt, detail) {
                    if (Date.now() - this.stallReportedAt < 30000) {
                        return;
                    }
                    this.stallReportedAt = Date.now();
                    axios.post('/api/playdiag', { path: this.nowPlayingVideo.url, evt: evt, detail: detail }).catch(() => { });
                },
                vm_videoError: function (evt) {
                    let err = evt.target.error;
                    // code 1 = 載入被中止（例如切換集數），不是真的失敗
                    if (!err || err.code === 1) {
                        return;
                    }
                    this.vm_reportPlayDiag('error', 'code=' + err.code + ' ' + (err.message || '') + ' readyState=' + evt.target.readyState);
                    let id = this.nowPlayingVideo.id;
                    let ext = (this.nowPlayingVideo.title.match(/\.[^.]+$/) || [''])[0].toUpperCase();
                    let unsupported = '這個瀏覽器無法播放此檔案' + (ext ? '（' + ext + '）' : '') +
                        '，可能是容器或編碼不支援（例如 MKV、H.265、10-bit）。可改用桌機 Chrome／Edge，或下載後用本機播放器觀看。';
                    if (err.code === 2) {
                        this.nowPlayingVideo.error = '載入中斷，可能是網路異常，請稍後再試。';
                        return;
                    }
                    if (err.code === 3) {
                        this.nowPlayingVideo.error = '影片解碼失敗，可能是編碼不支援或檔案損毀。';
                        return;
                    }
                    // code 4：實際請求一次，分辨是「伺服器未開放」「登入過期」還是「瀏覽器不支援」
                    this.nowPlayingVideo.error = unsupported;
                    fetch(this.nowPlayingVideo.url, { headers: { Range: 'bytes=0-0' } }).then(res => {
                        if (this.nowPlayingVideo.id !== id) {
                            return;
                        }
                        if (res.redirected && /\/page\/login/.test(res.url)) {
                            this.isLoggedIn = false;
                            this.redirectToLogin(id);
                        } else if (res.status === 404) {
                            this.nowPlayingVideo.error = '伺服器未開放播放此檔案類型' + (ext ? '（' + ext + '）' : '') + '，可以下載後觀看。';
                        }
                    }).catch(() => { });
                },
                vm_videoEnded: function (evt) {
                    this.vm_saveProgress(this.nowPlayingVideo.id, evt.target.currentTime, evt.target.duration, true);
                    this.nowPlayingVideo.ended = true;
                },
                vm_saveCurrentVideoProgress: function () {
                    let v = this.$refs.videoEl;
                    if (v && this.nowPlayingVideo.id && !this.nowPlayingVideo.ended) {
                        this.vm_saveProgress(this.nowPlayingVideo.id, v.currentTime, v.duration, false);
                    }
                },
                vm_saveProgress: function (id, t, d, ended) {
                    if (!id || !isFinite(d) || d <= 0) {
                        return;
                    }
                    let entry = { t: ended ? 0 : Math.floor(t), d: Math.floor(d), w: (ended || t / d >= 0.9) ? 1 : 0 };
                    let map = Object.assign({}, this.videoProgress);
                    delete map[id];
                    map[id] = entry;
                    let keys = Object.keys(map);
                    if (keys.length > 1000) {
                        keys.slice(0, keys.length - 1000).forEach(k => delete map[k]);
                    }
                    this.videoProgress = map;
                    try { window.localStorage.setItem('videoProgress', JSON.stringify(map)); } catch (e) { }
                },
                vm_epState: function (id) {
                    let p = this.videoProgress[id];
                    if (!p) {
                        return '';
                    }
                    if (p.w) {
                        return 'watched';
                    }
                    return p.t > 5 ? 'progress' : '';
                },
                vm_epClass: function (ep) {
                    let s = this.vm_epState(ep.item.id);
                    if (s === 'watched') {
                        return 'btn-secondary';
                    }
                    return s === 'progress' ? 'btn-outline-warning' : 'btn-outline-success';
                },
                vm_epStyle: function (ep) {
                    if (this.vm_epState(ep.item.id) !== 'progress') {
                        return null;
                    }
                    let p = this.videoProgress[ep.item.id];
                    let pct = Math.min(100, Math.round(p.t / p.d * 100));
                    return { background: 'linear-gradient(to right, rgba(255,193,7,0.35) ' + pct + '%, transparent ' + pct + '%)' };
                },
                vm_parseEpisode: function (title) {
                    let name = title.replace(/\.[^.]+$/, '');
                    // 例：[ANi] 作品名 - 01 [1080P]...，取最後一個「 - 數字」
                    let re = /(?:^|[\s_\]\)])-\s*(\d{1,3})(?:v\d+)?(?=[\s\[\(._]|$)/g;
                    let m, last = null;
                    while ((m = re.exec(name)) !== null) {
                        last = m[1];
                    }
                    if (last !== null) {
                        return parseInt(last, 10);
                    }
                    let pats = [/\[(\d{1,3})(?:v\d+)?\]/, /\bEP?\.?\s*(\d{1,3})\b/i, /第\s*(\d{1,3})\s*[話话集]/];
                    for (let i = 0; i < pats.length; i++) {
                        let r = pats[i].exec(name);
                        if (r) {
                            return parseInt(r[1], 10);
                        }
                    }
                    return null;
                },
                vm_captureCover: function (item, key) {
                    let self = this;
                    let v = document.createElement('video');
                    let done = false;
                    let timer = null;
                    let finish = function (dataUrl) {
                        if (done) {
                            return;
                        }
                        done = true;
                        clearTimeout(timer);
                        v.removeAttribute('src');
                        v.load();
                        if (dataUrl && self.videoFolderKey === key) {
                            self.videoCoverUrl = dataUrl;
                        }
                    };
                    timer = setTimeout(function () { finish(null); }, 15000);
                    v.muted = true;
                    v.playsInline = true;
                    v.preload = 'metadata';
                    v.addEventListener('loadedmetadata', function () {
                        let d = v.duration;
                        v.currentTime = (isFinite(d) && d > 0) ? Math.min(d * 0.1, 120) : 1;
                    });
                    v.addEventListener('seeked', function () {
                        try {
                            if (!v.videoWidth) {
                                finish(null);
                                return;
                            }
                            let w = 320;
                            let h = Math.round(w * v.videoHeight / v.videoWidth);
                            let c = document.createElement('canvas');
                            c.width = w;
                            c.height = h;
                            c.getContext('2d').drawImage(v, 0, 0, w, h);
                            finish(c.toDataURL('image/jpeg', 0.8));
                        } catch (e) {
                            finish(null);
                        }
                    });
                    v.addEventListener('error', function () { finish(null); });
                    v.src = item.get_url;
                },
                vm_playNextVideo: function () {
                    if (this.nowPlayingVideo.nextItem) {
                        this.vm_playVideo(this.nowPlayingVideo.nextItem);
                    }
                },
                vm_previewImage: function (item) {
                    this.setSelectedItem(item.id);
                    this.updatePreviewImage(item);
                },
                updatePreviewImage: function (item) {
                    let imageItems = this.items.filter(t => t.type === 'image');
                    let idx = imageItems.findIndex(t => t.id === item.id);
                    this.previewImage = {
                        id: item.id,
                        title: item.title,
                        url: item.get_url,
                        hasPrev: idx > 0,
                        hasNext: idx !== -1 && idx < imageItems.length - 1
                    };
                },
                vm_previewStep: function (delta) {
                    let imageItems = this.items.filter(t => t.type === 'image');
                    let idx = imageItems.findIndex(t => t.id === this.previewImage.id);
                    let nextIdx = idx + delta;
                    if (nextIdx < 0 || nextIdx >= imageItems.length) {
                        return;
                    }
                    this.setSelectedItem(imageItems[nextIdx].id);
                    this.updatePreviewImage(imageItems[nextIdx]);
                },
                vm_closeImagePreview: function () {
                    this.previewImage = { id: null, title: '', url: '', hasPrev: false, hasNext: false };
                },
                vm_previewText: function (item) {
                    let self = this;
                    this.setSelectedItem(item.id);
                    let sep = item.get_url.indexOf('?') === -1 ? '?' : '&';
                    axios.get(item.get_url + sep + 'preview=true').then(function (res) {
                        self.previewText = {
                            id: item.id,
                            title: item.title,
                            type: res.data.type,
                            content: res.data.type === 'md' ? res.data.html : res.data.text
                        };
                    }).catch(function () {
                        window.open(item.get_url, '_blank');
                    });
                },
                vm_closeTextPreview: function () {
                    this.previewText = { id: null, title: '', type: '', content: '' };
                },
                vm_findCoverUrl: function (musicItems) {
                    // 搜尋/我的最愛會混合多個資料夾（有 path 欄位），找不到單一封面
                    if (musicItems.some(t => t.path)) {
                        return '';
                    }
                    let names = ['cover.jpg', 'cover.jpeg', 'cover.png', 'folder.jpg', 'folder.jpeg', 'folder.png'];
                    for (let i = 0; i < names.length; i++) {
                        let found = this.allItems.find(t => t.type === 'image' && t.title.toLowerCase() === names[i]);
                        if (found) {
                            return new URL(found.get_url, location.href).href;
                        }
                    }
                    return '';
                },
                vm_stepTrack: function (delta) {
                    let next = this.playQueueIndex + delta;
                    if (next < 0 || next >= this.playQueue.length) {
                        if (this.autoLoop && this.playQueue.length > 1) {
                            next = (next + this.playQueue.length) % this.playQueue.length;
                        } else {
                            return;
                        }
                    }
                    this.playQueueIndex = next;
                    let nitem = this.playQueue[next];
                    this.vm_playMusic(nitem.get_url, nitem.id);
                },
                vm_updateMediaSession: function () {
                    this.vm_setMediaMetadata(this.nowPlaying.title, this.nowPlaying.artist, this.nowPlaying.album, this.playCoverUrl);
                },
                // 鎖屏/控制中心的按鈕在音樂與影片之間共用，切換播放對象時要重新綁定
                vm_setMediaSessionMode: function (mode) {
                    if (!('mediaSession' in navigator)) {
                        return;
                    }
                    let self = this;
                    let setHandler = function (action, fn) {
                        try { navigator.mediaSession.setActionHandler(action, fn); } catch (e) { }
                    };
                    if (mode === 'video') {
                        let nv = this.nowPlayingVideo;
                        let video = function () { return self.$refs.videoEl; };
                        setHandler('play', function () { if (video()) { video().play(); } });
                        setHandler('pause', function () { if (video()) { video().pause(); } });
                        setHandler('previoustrack', nv.prevItem ? function () { self.vm_playVideo(self.nowPlayingVideo.prevItem); } : null);
                        setHandler('nexttrack', nv.nextItem ? function () { self.vm_playVideo(self.nowPlayingVideo.nextItem); } : null);
                        setHandler('seekbackward', function (d) {
                            if (video()) { video().currentTime = Math.max(0, video().currentTime - ((d && d.seekOffset) || 10)); }
                        });
                        setHandler('seekforward', function (d) {
                            if (video()) { video().currentTime = Math.min(video().duration || Infinity, video().currentTime + ((d && d.seekOffset) || 10)); }
                        });
                        setHandler('seekto', function (d) {
                            if (video() && d && typeof d.seekTime === 'number') { video().currentTime = d.seekTime; }
                        });
                        return;
                    }
                    setHandler('play', function () { self.vm_audioPlay(); });
                    setHandler('pause', function () { self.vm_audioPause(); });
                    setHandler('previoustrack', function () { self.vm_stepTrack(-1); });
                    setHandler('nexttrack', function () { self.vm_stepTrack(1); });
                    setHandler('seekbackward', null);
                    setHandler('seekforward', null);
                    setHandler('seekto', function (d) {
                        if (d && typeof d.seekTime === 'number') {
                            window.audio.currentTime = d.seekTime;
                        }
                    });
                },
                vm_setMediaMetadata: function (title, artist, album, artworkSrc) {
                    if (!('mediaSession' in navigator) || typeof MediaMetadata === 'undefined') {
                        return;
                    }
                    try {
                        navigator.mediaSession.metadata = new MediaMetadata({
                            title: title,
                            artist: artist,
                            album: album,
                            artwork: artworkSrc ? [{ src: artworkSrc }] : []
                        });
                    } catch (e) {
                        console.log('mediaSession metadata failed', e);
                    }
                },
                vm_updateVideoMediaSession: function () {
                    if (!('mediaSession' in navigator)) {
                        return;
                    }
                    let nv = this.nowPlayingVideo;
                    let folder = this.videoFolder;
                    let title = (nv.label && folder && folder.title) ? nv.label + ' · ' + folder.title : nv.title;
                    let artwork = (folder || this.singleVideo) ? this.videoCoverUrl : '';
                    this.vm_setMediaSessionMode('video');
                    this.vm_setMediaMetadata(title, folder ? folder.quality : '', '', artwork);
                    if (!artwork && nv.coverApi) {
                        // 單獨一部影片：嘗試用內嵌封面；轉成 data URL 以免鎖屏取圖時沒有登入 cookie
                        let id = nv.id;
                        this.vm_loadCover(nv.coverApi).then(dataUrl => {
                            if (this.nowPlayingVideo.id === id) {
                                this.vm_setMediaMetadata(title, '', '', dataUrl);
                            }
                        }).catch(() => { });
                    }
                },
                vm_restoreAudioMediaSession: function () {
                    if (!('mediaSession' in navigator)) {
                        return;
                    }
                    if (window.audio && this.nowPlaying.id) {
                        this.vm_setMediaSessionMode('audio');
                        this.vm_updateMediaSession();
                    } else {
                        try { navigator.mediaSession.metadata = null; } catch (e) { }
                    }
                },
                vm_coverApiUrl: function (item) {
                    return item.get_url + (item.get_url.indexOf('?') === -1 ? '?' : '&') + 'cover=true';
                },
                // 載入圖片並縮成最長邊 512px 的 JPEG data URL（失敗/404 會 reject）
                vm_loadCover: function (url) {
                    return new Promise(function (resolve, reject) {
                        let img = new Image();
                        img.onload = function () {
                            try {
                                let scale = Math.min(1, 512 / Math.max(img.naturalWidth, img.naturalHeight));
                                let c = document.createElement('canvas');
                                c.width = Math.max(1, Math.round(img.naturalWidth * scale));
                                c.height = Math.max(1, Math.round(img.naturalHeight * scale));
                                c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
                                resolve(c.toDataURL('image/jpeg', 0.85));
                            } catch (e) {
                                reject(e);
                            }
                        };
                        img.onerror = function () { reject(new Error('cover not found')); };
                        img.src = url;
                    });
                },
                setFilter: function (type) {
                    this.activeFilter = type;
                },
                redirectToLogin: function (itemId) {
                    let target = location.pathname + location.search;
                    if (itemId) {
                        target += (target.indexOf('?') === -1 ? '?' : '&') + 'playId=' + encodeURIComponent(itemId);
                    }
                    location.href = '/page/login?returnUrl=' + encodeURIComponent(target);
                },
                logoutHref: function () {
                    return '/logout?returnUrl=' + encodeURIComponent(location.pathname + location.search);
                },
                vm_renderItems: function (res) {
                    const items = res.items;
                    const breadcrumbs = res.breadcrumbs
                    const message = res.message;

                    this.favView = false;

                    this.newsView = false;
                    this.currentRating = res.current || null;
                    this.vm_loadMediaInfo(res, items);
                    this.ratingFilter = 'all';
                    this.vm_markPlaying(res.items, res.discs);
                    // 排序記憶的 key：同一個資料夾從網址進入與從上層點進去的 id 不同（有無開頭的 /），所以用伺服器回傳的標準路徑；根目錄不記
                    this.sortFolderId = res.id ? (res.url || res.id) : '';
                    this.sortMode = this.vm_loadSortPref(this.sortFolderId, items.some(t => t.rateable));
                    this.allItems = items;
                    this.notFound = null;
                    this.loadError = '';
                    this.discGroups = res.discs || null;
                    this.activeFilter = null;
                    this.breadcrumbs = breadcrumbs;

                    this.footerMessage = message;

                    this.searchIsVisible = false;
                    this.breadcrumbIsVisible = true;

                    if (this.pendingPlayId) {
                        let target = this.items.find(t => t.id === this.pendingPlayId);
                        this.pendingPlayId = null;
                        if (target) {
                            this.vm_changeFolder(target);
                        }
                    }

                    let self = this;
                    window.setTimeout(function () {
                        self.adjustScrollTop();
                    },50);
                },
                // ----- FLAC 轉 MP3 -----
                vm_transcodeText: function (item) {
                    if (item.transcode_state === 'pending') {
                        return this.flacOriginal ? 'MP3 轉檔中…（目前播原檔）' : 'MP3 轉檔中…完成後即可播放';
                    }
                    if (item.transcode_state === 'failed') {
                        return '轉檔失敗，改播原檔';
                    }
                    return 'MP3 已就緒';
                },
                vm_findTrack: function (id) {
                    return this.playQueue.find(t => t.id === id) || this.items.find(t => t.id === id) || this.transcodeItems.find(t => t.id === id) || null;
                },
                // 決定實際要播的網址：FLAC 轉好了播 MP3；還沒轉好回傳 null（不播，提示等待）；選了「播原檔」、轉檔失敗或不是 FLAC 就播原網址
                vm_resolveAudioUrl: function (item, url) {
                    if (!this.transcodeEnabled || !item || !item.transcode_state || this.flacOriginal) {
                        return url;
                    }
                    if (item.transcode_state === 'ready') {
                        return url + (url.indexOf('?') === -1 ? '?' : '&') + 'mp3=true';
                    }
                    if (item.transcode_state === 'pending') {
                        return null;
                    }
                    return url;
                },
                vm_transcodeBlocked: function (item) {
                    this.transcodeNote = '「' + (item.track_title || item.title) + '」還在轉 MP3，轉好就能播放（或勾選「FLAC 播原檔」立即播放）';
                    if (this.transcodeNoteTimer) { clearTimeout(this.transcodeNoteTimer); }
                    this.transcodeNoteTimer = setTimeout(() => { this.transcodeNote = ''; this.transcodeNoteTimer = null; }, 8000);
                    this.vm_pollTranscode(item.id);        // 把這首移到佇列最前面，並馬上更新狀態
                },
                vm_pollTranscode: function (first) {
                    let ids = this.transcodeItems.filter(t => t.transcode_state === 'pending').map(t => t.id);
                    if (first && ids.indexOf(first) === -1) {
                        ids.push(first);
                    }
                    if (ids.length === 0) {
                        return Promise.resolve();
                    }
                    return api.transcodeStatus(ids, first).then(res => {
                        let states = res.data.states || {};
                        this.transcodeItems.forEach(it => {
                            if (states[it.id] !== undefined && states[it.id] !== null) {
                                it.transcode_state = states[it.id];
                            }
                        });
                    }).catch(() => { });
                },
                vm_scheduleTranscodePoll: function () {
                    if (this.transcodePollTimer) {
                        clearTimeout(this.transcodePollTimer);
                        this.transcodePollTimer = null;
                    }
                    if (this.transcodePendingCount <= 0) {
                        return;
                    }
                    this.transcodePollTimer = setTimeout(() => {
                        this.transcodePollTimer = null;
                        this.vm_pollTranscode().then(() => this.vm_scheduleTranscodePoll());
                    }, 3000);
                },
                vm_playMusic: function(audioURL, id) {
                    let self = this;
                    let tcItem = this.vm_findTrack(id);
                    let resolvedUrl = this.vm_resolveAudioUrl(tcItem, audioURL);
                    if (resolvedUrl === null) {
                        this.vm_transcodeBlocked(tcItem);
                        return;
                    }
                    audioURL = resolvedUrl;
                    if (window.audio == null) {
                        window.audio = new Audio();
                        window.audio.addEventListener('timeupdate', t => {
                            self.nowPlaying.currentTime = window.audio.currentTime;
                            let d = window.audio.duration;
                            if ('mediaSession' in navigator && navigator.mediaSession.setPositionState && isFinite(d) && d > 0) {
                                try {
                                    navigator.mediaSession.setPositionState({
                                        duration: d,
                                        position: Math.min(window.audio.currentTime, d),
                                        playbackRate: window.audio.playbackRate || 1
                                    });
                                } catch (e) { }
                            }
                        });
                        window.audio.addEventListener('loadedmetadata', t => {
                            self.nowPlaying.duration = window.audio.duration;
                        });
                        window.audio.addEventListener('play', t => {
                            self.nowPlaying.paused = false;
                            self.audioInterruptedAt = 0;
                            self.resumeHint = false;
                        });
                        window.audio.addEventListener('pause', t => {
                            self.nowPlaying.paused = true;
                            // 不是我們自己要暫停的（使用者按暫停、換歌、播完都不算），而且發生在切到別的 App 的前後：視為被打斷（例如別的 App 開始播影片搶走聲音）
                            let a = window.audio;
                            if (self.audioIntent === 'play' && !a.ended && !a.seeking) {
                                self.audioLastPauseAt = Date.now();
                                if (self.audioInterruptedAt === 0 && (document.visibilityState === 'hidden' || Date.now() - self.lastHiddenAt < 2000)) {
                                    self.audioInterruptedAt = Date.now();
                                }
                            }
                        });
                        window.audio.addEventListener('error', t => {
                            console.log('audio error, checking login state', t);
                            api.info().then(res => {
                                self.isLoggedIn = !!res.data.name;
                                if (self.isLoggedIn === false) {
                                    self.redirectToLogin(self.nowPlaying.id);
                                } else {
                                    alert('無法播放此檔案');
                                }
                            });
                        });
                        window.audio.addEventListener('ended', t=> {
                            console.log('track ended');
                            let current = self.items.find(it => it.id === self.nowPlaying.id) ||
                                self.playQueue.find(it => it.id === self.nowPlaying.id);
                            if (current) {
                                current.playing = false;
                            }
                            if (self.autoNext === false) {
                                console.log('auto next is off');
                                return;
                            }
                            self.playQueueIndex++;
                            if (self.autoLoop && self.playQueueIndex >= self.playQueue.length) {
                                self.playQueueIndex = 0;
                            }
                            if (self.playQueueIndex >= 0 && self.playQueueIndex < self.playQueue.length) {
                                let nitem = self.playQueue[self.playQueueIndex];
                                console.log('play next in queue: ' + nitem.title);
                                self.vm_playMusic(nitem.get_url, nitem.id);
                            } else {
                                console.log('no next song in queue');
                            }
                        });
                    } else {
                        if (window.audio.paused == false) {
                            let currentSongClickAgain = false;
                            console.log('music pause.');
                            for (let item of this.items.concat(this.playQueue)) {
                                
                                if (item.playing && item.id == id)  {
                                    item.playing = false;
                                    currentSongClickAgain = true;
                                    break;
                                } else {
                                    item.playing = false;
                                }                                
                            }
                            if (currentSongClickAgain) {
                                window.audio.pause();
                            }                            
                        }
                    }

                    this.audioIntent = 'play';
                    this.audioInterruptedAt = 0;
                    this.resumeHint = false;
                    this.pauseToken++;
                    let playToken = ++this.playToken;
                    this.vm_applyTrackGain(id);

                    try {
                        window.audio.src = audioURL;                    
                        var playPromise = window.audio.play();
                        if (playPromise !== undefined) {
                        playPromise.then(function() {
                            // Automatic playback started!
                        }).catch(function(e) {
                            // 還在載入時換歌（或暫停）會讓前一個 play() 以 AbortError 結束，那不是播放失敗；
                            // 也不理會已經被新的播放要求取代的舊要求。只有瀏覽器真的不讓播（例如 Safari 的自動播放限制）才開新頁
                            if ((e && e.name === 'AbortError') || self.playToken !== playToken) {
                                return;
                            }
                            window.open(audioURL, '_blank');
                            return;
                        });
                        }
                    } catch {
                        alert('not allow. safari');
                        return;
                    }

                    let playingItem;
                    for(i in this.items) {
                        let item = this.items[i];
                        if (item.id == id) {
                            item.playing = true;
                            playingItem = item;
                        }
                    }
                    if (!playingItem) {
                        playingItem = this.playQueue.find(t => t.id === id);
                    }
                    // 多片裝的歌曲不在 items 裡，用播放佇列維持「正在播放」旗標
                    this.playQueue.forEach(t => { t.playing = (t.id === id); });
                    this.setSelectedItem(id);
                    this.nowPlaying.id = id;
                    this.nowPlaying.title = playingItem ? (playingItem.track_title || playingItem.title) : '';
                    this.nowPlaying.artist = playingItem ? (playingItem.artist || '') : '';
                    this.nowPlaying.album = playingItem ? (playingItem.album || '') : '';
                    // 實際播放的格式（FLAC 才標示）：轉好的 MP3 或原始 FLAC，一眼就能分辨
                    this.nowPlaying.format = /[?&]mp3=true(&|$)/.test(audioURL) ? 'MP3（轉檔）' : (/\.flac(\?|$)/i.test(audioURL) ? 'FLAC 原檔' : '');
                    this.nowPlaying.currentTime = 0;
                    this.nowPlaying.duration = 0;
                    this.vm_setMediaSessionMode('audio');
                    this.vm_updateMediaSession();

                    console.log('play');
                    this.vm_scrollToPlaying();
                },
                vm_seekInput: function (evt) {
                    this.seekingTime = parseFloat(evt.target.value);
                },
                vm_seek: function (evt) {
                    if (window.audio) {
                        window.audio.currentTime = evt.target.value;
                    }
                    this.seekingTime = null;
                },
                vm_togglePause: function () {
                    if (window.audio == null) {
                        return;
                    }
                    if (window.audio.paused) {
                        this.vm_audioPlay();
                    } else {
                        this.vm_audioPause();
                    }
                },
                formatTime: function (seconds) {
                    if (!seconds || isNaN(seconds)) {
                        return '0:00';
                    }
                    let m = Math.floor(seconds / 60);
                    let s = Math.floor(seconds % 60);
                    return m + ':' + (s < 10 ? '0' : '') + s;
                },
                // 專輯名稱去掉光碟後綴：Album (Disc 1)、Album [CD2]、Album - Disc 2、Album 第2碟
                vm_albumBase: function (album) {
                    let base = album
                        .replace(/[\s\-–—_]*[(\[（【]?\s*(?:disc|disk|cd|dvd)\s*[-_.]?\s*\d{1,2}\s*[)\]）】]?\s*$/i, '')
                        .replace(/[\s\-–—_]*[(\[（【]?\s*第\s*\d{1,2}\s*[碟盤片]\s*[)\]）】]?\s*$/, '')
                        .trim();
                    return base || album;
                },
                // 檔名開頭的曲序數字：01_xxx、1. xxx、02 xxx
                vm_leadingNumber: function (title) {
                    let m = /^\s*(\d{1,3})\s*[._\-)\]、\s]/.exec(title);
                    return m ? parseInt(m[1], 10) : null;
                },
                // 沒有 ID3 標題時：去掉副檔名與前置曲序
                vm_cleanTrackName: function (title) {
                    let name = title.replace(/\.[^.]+$/, '');
                    let cleaned = name.replace(/^\s*\d{1,3}\s*[._\-)\]、\s]+/, '');
                    return cleaned || name;
                },
                // 影片長度：1 小時以上顯示 h:mm:ss，否則 m:ss
                formatDuration: function (seconds) {
                    let total = Math.round(seconds);
                    let h = Math.floor(total / 3600);
                    let m = Math.floor((total % 3600) / 60);
                    let sec = total % 60;
                    let pad = n => (n < 10 ? '0' : '') + n;
                    return h > 0 ? h + ':' + pad(m) + ':' + pad(sec) : m + ':' + pad(sec);
                },
                formatArtistAlbum: function (item) {
                    if (item.artist && item.album) {
                        return item.artist + ' - ' + item.album;
                    }
                    return item.artist || item.album || '';
                },
                handleKeyDownEvent: function (evt) {
                    if (this.ratingPicker) {
                        if (evt.keyCode == 27) {
                            this.ratingPicker = null;
                        } else if (evt.keyCode == 13) {
                            // 擋掉焦點所在按鈕被 Enter 觸發的原本動作，統一當成「確定」
                            evt.preventDefault();
                            this.vm_confirmRating();
                        }
                        return;
                    }
                    if (this.nowPlayingVideo.id) {
                        let tag = (evt.target && evt.target.tagName) || '';
                        let v = this.$refs.videoEl;
                        if (evt.keyCode == 27) {
                            this.vm_closeVideo();
                            return;
                        }
                        if (!v || tag === 'SELECT' || tag === 'INPUT') {
                            return;
                        }
                        // 焦點在 video 本身時，空白/左右鍵由瀏覽器原生處理，避免重複作用
                        if (evt.keyCode == 32 && tag !== 'VIDEO' && tag !== 'BUTTON') {
                            evt.preventDefault();
                            if (v.paused) { v.play(); } else { v.pause(); }
                        } else if (evt.keyCode == 37 && tag !== 'VIDEO') {
                            evt.preventDefault();
                            v.currentTime = Math.max(0, v.currentTime - 10);
                        } else if (evt.keyCode == 39 && tag !== 'VIDEO') {
                            evt.preventDefault();
                            v.currentTime = Math.min(v.duration || v.currentTime + 10, v.currentTime + 10);
                        } else if (evt.keyCode == 70) {
                            if (document.fullscreenElement) {
                                document.exitFullscreen();
                            } else if (v.requestFullscreen) {
                                v.requestFullscreen();
                            }
                        }
                        return;
                    }
                    if (this.previewText.id) {
                        if (evt.keyCode == 27) {
                            this.vm_closeTextPreview();
                        }
                        return;
                    }
                    if (this.previewImage.id) {
                        if (evt.keyCode == 27) {
                            this.vm_closeImagePreview();
                        } else if (evt.keyCode == 37) {
                            this.vm_previewStep(-1);
                        } else if (evt.keyCode == 39) {
                            this.vm_previewStep(1);
                        }
                        return;
                    }
                    if (evt.keyCode == 27) {
                        if (this.searchIsVisible) {
                            this.toggleBarMode();
                        }
                        this.menuOpen = false;
                        return;
                    }
                    // 焦點在輸入框／下拉選單等可輸入的元素時，方向鍵與 Enter 交給它們自己處理（不跳上一頁、不點選清單）
                    let focusTag = (evt.target && evt.target.tagName) || '';
                    if (focusTag === 'INPUT' || focusTag === 'TEXTAREA' || focusTag === 'SELECT' || (evt.target && evt.target.isContentEditable)) {
                        // 在搜尋框按 ↓：把焦點移到結果清單，選取第一筆；之後上下鍵、Enter、→ 就是清單的操作
                        if (evt.keyCode == 40 && evt.target.classList.contains('search-component-input') && this.items.length > 0) {
                            evt.preventDefault();
                            evt.target.blur();
                            this.items.forEach(t => { t.selected = false; });
                            this.items[0].selected = true;
                            this.$forceUpdate();
                            this.adjustScrollTop();
                        }
                        return;
                    }
                    if (evt.keyCode == 40) {
                        let selectedIndex = -1;
                        for (i in this.items) {
                            let item = this.items[i];
                            if (item.selected) {
                                selectedIndex = parseInt(i, 10);
                                break;
                            }                                
                        }
                        let nextIndex = 0;
                        if (selectedIndex != -1) {                                
                            nextIndex = selectedIndex + 1;
                        }
                        console.log('key 40 debug:' +
                            selectedIndex + '/' + nextIndex + '/' + this.items.length);
                        if (nextIndex == this.items.length) {
                            return;
                        }
                        if (selectedIndex != -1) {
                            this.items[selectedIndex].selected = false;
                        }
                        this.items[nextIndex].selected = true;
                        this.$forceUpdate();
                        window.event.preventDefault();
                    }
                    if (evt.keyCode == 38) {
                        let selectedIndex = -1;
                        for (i in this.items) {
                            let item = this.items[i];
                            if (item.selected) {
                                selectedIndex = parseInt(i, 10);
                                break;
                            }                                
                        }
                        let nextIndex = 0;
                        if (selectedIndex != -1) {                                
                            nextIndex = selectedIndex - 1;
                        }                            
                        if (nextIndex == -1) {
                            return;
                        }
                        if (selectedIndex != -1) {
                            this.items[selectedIndex].selected = false;
                        }
                        this.items[nextIndex].selected = true;
                        this.$forceUpdate();
                        window.event.preventDefault();
                    }                    
                    if (evt.keyCode == 37) {
                        console.log('keycode:37-try back' + evt.keyCode);
                        history.back();
                    }
                    if (evt.keyCode == 13 || evt.keyCode == 39) {
                        let selectedEl = document.querySelector('.selected-item-row');
                        if (selectedEl) {
                            selectedEl.click();
                        }
                    }

                    this.adjustScrollTop();
                        
                },
                setSelectedItem: function (itemId) {
                    console.log('set selected: ' + itemId);
                    this.items.forEach(t => {
                        t.selected = false;
                    });
                    let selectedItem = this.items.find(t => {
                        return t.id == itemId
                    });
                    if (selectedItem != null) {
                        selectedItem.selected = true;
                        if (selectedItem.type != 'folder') {
                            this.$forceUpdate();
                        }
                    }
                },
                adjustScrollTop: function () {
                    this.$nextTick(function () {
                        //check selected-row at view
                        let selectedEl = document.querySelector('.selected-item-row');
                        let bottomMark = document.querySelector('.bottom-mark');
                        let topMark = document.querySelector('.top-mark');
                        if (selectedEl && bottomMark && topMark) {
                            let selectedRect = selectedEl.getBoundingClientRect();
                            if (selectedRect.top + selectedRect.height > bottomMark.getBoundingClientRect().top) {
                                document.documentElement.scrollTop += 50;
                            }
                            if (selectedRect.top < topMark.getBoundingClientRect().top) {
                                if (document.documentElement.scrollTop >= 50) {
                                    document.documentElement.scrollTop -= 50;
                                }
                            }
                        }
                    });
                },
                vm_itemOver: function (itemId) {
                    console.log('over: ' + itemId);                        
                    this.setSelectedItem(itemId);
                        
                },
                showKeyword() {
                    console.log('k=>' + this.keyword);
                },
                doSearch(k) {
                    console.log('begin search, data:' + JSON.stringify({ 'q': this.keyword }));
                    if(!this.keyword) {
                        alert('請輸入');
                        return;
                    }
                    this.searchIsVisible = true;
                    this.loading = true;
                    api.search(this.keyword).then((res) => {
                        var data = res.data;
                        this.getSearchResult(this.keyword, data.items, data.message);
                    }).finally(() => {
                        this.loading = false;
                    });
                    this.$nextTick(()=>{
                        document.querySelector('#search-component-keyword').focus();
                    });
                },
                getSearchResult(keyword, items, message) {
                    this.notFound = null;
                    this.loadError = '';
                    this.favView = false;
                    this.newsView = false;
                    this.currentRating = null;
                    this.allItems = items;
                    this.activeFilter = null;
                    this.footerMessage = message;
                    this.searchPerformed = true;
                    let searchUrl = '/page?search=' + keyword;
                    let state = {'keyword': keyword};
                    console.log('push-state:' + searchUrl);
                    window.history.pushState(state,'', searchUrl);

                }
            }
        };

        const app = Vue.createApp(App);

        app.component('BreadcrumbsComponent', {
          template: `
            <div id="breadcrumbs" ref="bc" style="align-self:center">
                <template v-for="(item, idx) in items">
                    <span v-if="idx > 0" class="sep">&rsaquo;</span>
                    <a class="crumb" :class="{ 'crumb-current': currentLast && idx === items.length - 1 }"
                        v-on:click.stop="itemClick(item)" href="javascript:void(0)">{{ item.text }}</a>
                </template>
            </div>
            `,
          data: function () {
            return {
            }
          },
          props: ['items', 'currentLast'],
          mounted: function () {
            this.scrollToEnd();
          },
          watch: {
            items: function () {
              this.$nextTick(this.scrollToEnd);
            }
          },
          methods: {
            // 路徑太長時，捲到最右邊，確保看得到目前所在的資料夾
            scrollToEnd: function () {
                let el = this.$refs.bc;
                if (el) {
                    el.scrollLeft = el.scrollWidth;
                }
            },
            itemClick: function(item) {
                if (item.id != null) {
                    //
                    this.$emit('select-breadcrumb', item.id, true);                    
                }
            }
          }
        });

        app.mount('#app');


    </script>

</body>
