   <style type="text/css">
        /* 麵包屑：每一層是一顆 40px 高的膠囊按鈕，好點、有按壓回饋；太長時在導覽列內橫向捲動 */
        #breadcrumbs {
            display: flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
            overflow-x: auto;
            font-size: 14px;
            min-width: 0;
            padding: 2px 0;
            scrollbar-width: none;
        }

        #breadcrumbs::-webkit-scrollbar {
            display: none;
        }

        #breadcrumbs .crumb {
            flex: 0 0 auto;
            display: inline-block;
            box-sizing: border-box;
            max-width: 70vw;
            height: 40px;
            line-height: 40px;
            padding: 0 14px;
            border-radius: 20px;
            overflow: hidden;
            text-overflow: ellipsis;
            background: rgba(255, 255, 255, 0.14);
            color: cornsilk;
            text-decoration: none;
            -webkit-tap-highlight-color: transparent;
        }

        #breadcrumbs .crumb:active {
            background: rgba(255, 255, 255, 0.4);
        }

        #breadcrumbs .crumb-current {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.4);
            line-height: 38px;
            font-weight: 700;
            color: #fff;
            pointer-events: none;
        }

        #breadcrumbs .sep {
            flex: 0 0 auto;
            color: rgba(255, 255, 255, 0.5);
        }

        /* 窄螢幕（< 576px）空間優先：隱藏分隔符號，靠左到右的順序與「外框的最後一層」辨識層級，膠囊間距放大一點 */
        @@media (max-width: 575.98px) {
            #breadcrumbs {
                gap: 6px;
            }

            #breadcrumbs .sep {
                display: none;
            }
        }

        .nav-icon-btn {
            width: 40px;
            height: 40px;
            padding: 0;
        }

        .audio-icon {
            font-size:32px;color:silver;
        }

        .audio-playing {
            font-size:32px;color:black;
        }
    </style>

    <script type="text/javascript">

       
        const App = {
            data() {
                return {
                    breadcrumbIsVisible: true,
                    breadcrumbs: [],
                    allItems: [],
                    activeFilter: null,
                    searchIsVisible: false,
                    keyword: '',
                    footerMessage: '',
                    searchPerformed: false,
                    loading: false,
                    menuOpen: false,
                    pendingPlayId: null,
                    playQueue: [],
                    playQueueIndex: -1,
                    playCoverUrl: '',
                    showListView: false,
                    newsEnabled: false,
                    newsUnread: 0,
                    newsView: false,
                    newsEntries: [],
                    newsRange: 1,
                    transcodeEnabled: false,
                    isAdmin: false,
                    mediaInfo: null,
                    flacOriginal: false,
                    transcodeNote: '',
                    transcodePollTimer: null,
                    transcodeNoteTimer: null,
                    currentRating: null,
                    ratingPicker: null,
                    sortMode: 'default',
                    sortFolderId: '',
                    ratingFilter: 'all',
                    copyMsg: '',
                    copyDialog: null,
                    favAlbumMap: {},
                    favTrackMap: {},
                    favView: false,
                    favTab: 'album',
                    favTarget: null,
                    favPending: 0,
                    favPollTimer: null,
                    loudnessOn: true,
                    playQueueGain: false,
                    audioCtx: null,
                    gainNode: null,
                    trackGain: 1,
                    pauseToken: 0,
                    audioIntent: 'pause',
                    lastUserScrollAt: 0,
                    audioInterruptedAt: 0,
                    audioLastPauseAt: 0,
                    lastHiddenAt: 0,
                    resumeHint: false,
                    playToken: 0,
                    audioGraphFailed: false,
                    discGroups: null,
                    notFound: null,
                    loadError: '',
                    loadErrorFolder: '',
                    videoCoverUrl: '',
                    videoProgress: {},
                    videoRate: 1,
                    videoSaveAt: 0,
                    subtitleIgnoreUntil: 0,
                    videoSlowHint: '',
                    stallTimer: null,
                    stallHintMs: 8000,
                    stallReportedAt: 0,
                    subtitleIndex: -1,
                    autoNext: true,
                    autoLoop: false,
                    seekingTime: null,
                    isLoggedIn: null,
                    nowPlaying: {
                        id: null,
                        title: '',
                        artist: '',
                        album: '',
                        format: '',
                        currentTime: 0,
                        duration: 0,
                        paused: true
                    },
                    nowPlayingVideo: {
                        id: null,
                        title: '',
                        label: '',
                        url: '',
                        coverApi: '',
                        bytes: 0,
                        duration: 0,
                        subtitles: [],
                        error: '',
                        ended: false,
                        hasNext: false,
                        nextItem: null,
                        prevItem: null
                    },
                    previewImage: {
                        id: null,
                        title: '',
                        url: '',
                        hasPrev: false,
                        hasNext: false
                    },
                    previewText: {
                        id: null,
                        title: '',
                        type: '',
                        content: ''
                    }
                }
            },
            computed: {
                items: function() {
                    if (this.favView) {
                        let type = this.favTab === 'album' ? 'folder' : 'music';
                        return this.allItems.filter(t => t.type === type);
                    }
                    let base = this.allItems;
                    if (this.hiddenCoverFileId) {
                        base = base.filter(t => t.id !== this.hiddenCoverFileId);
                    }
                    if (this.activeFilter) {
                        base = base.filter(t => t.type === 'folder' || t.type === this.activeFilter);
                    }
                    if (this.ratingList) {
                        // 季資料夾（裡面是可評分的動畫）：依評分篩選，其他項目不受影響
                        let val = t => (t.rating > 0 ? t.rating : null);
                        if (this.ratingFilter === '4') {
                            base = base.filter(t => !t.rateable || (val(t) !== null && val(t) >= 4));
                        } else if (this.ratingFilter === '3.5') {
                            base = base.filter(t => !t.rateable || (val(t) !== null && val(t) >= 3.5));
                        } else if (this.ratingFilter === 'none') {
                            base = base.filter(t => !t.rateable || val(t) === null);
                        }
                    }
                    return this.vm_sortItems(base);
                },
                // 排序選單是否顯示：只在「單一資料夾」的列表（不含搜尋/我的最愛、也不含專輯與追番的專屬版面），
                // 項目至少 6 個才有排序的必要（已經選過排序的資料夾一律顯示，才看得到為什麼是這個順序）
                sortBarVisible: function() {
                    if (this.favView || this.videoGridVisible || this.musicGridVisible || !this.sortFolderId) {
                        return false;
                    }
                    if (this.allItems.length === 0 || this.allItems.some(t => t.path)) {
                        return false;
                    }
                    return this.allItems.length >= 6 || this.sortMode !== 'default';
                },
                // 目前畫面是否就是正在播放那首歌所在的資料夾（搜尋、我的最愛這類跨資料夾的清單不算）
                inPlayingFolder: function() {
                    if (!this.nowPlaying.id || this.favView || this.searchIsVisible || this.allItems.some(t => t.path)) {
                        return false;
                    }
                    let cur = this.breadcrumbs.length ? this.breadcrumbs[this.breadcrumbs.length - 1].id : null;
                    if (!cur) {
                        return false;
                    }
                    let norm = p => '/' + (p || '').replace(/^\/+/, '');
                    return norm(this.vm_idToPath(cur)) === norm(this.vm_playingFolderPath());
                },
                // 新上架的時間範圍分頁（1／14／90 天內；數量是累計的）
                newsRangeTabs: function() {
                    let now = Date.now();
                    return [1, 14, 90].map(d => ({ days: d, count: this.newsEntries.filter(e => now - e.time <= d * 86400000).length }));
                },
                newsFiltered: function() {
                    let limit = Date.now() - this.newsRange * 86400000;
                    return this.newsEntries.filter(e => e.time >= limit);
                },
                // 新上架清單依日期分組（今天、昨天、其他日期）
                newsGroups: function() {
                    let groups = [], byLabel = {};
                    let now = new Date();
                    let today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
                    this.newsFiltered.forEach(e => {
                        let d = new Date(e.time);
                        let day = new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
                        let label = day === today ? '今天' : (day === today - 86400000 ? '昨天' : (d.getFullYear() + '/' + (d.getMonth() + 1) + '/' + d.getDate()));
                        if (!byLabel[label]) {
                            byLabel[label] = { label: label, items: [] };
                            groups.push(byLabel[label]);
                        }
                        byLabel[label].items.push(e);
                    });
                    return groups;
                },
                ratingChoices: function() {
                    return [2.5, 3, 3.5, 4, 4.5, 5];
                },
                // 目前列表裡有可評分的動畫資料夾（跨資料夾的搜尋不算）
                ratingList: function() {
                    return !this.favView && this.allItems.some(t => t.rateable);
                },
                // 目前清單裡有 FLAC 轉檔狀態的歌曲（有的話才顯示「FLAC 播原檔」）
                // 目前畫面上所有可能有轉檔狀態的歌曲：一般清單，加上多片裝（Disc 1／Disc 2…）各光碟裡的歌（它們不在 allItems 裡）
                transcodeItems: function() {
                    let list = this.allItems.slice();
                    (this.discGroups || []).forEach(d => (d.items || []).forEach(t => list.push(t)));
                    return list;
                },
                hasTranscode: function() {
                    return this.transcodeItems.some(t => t.transcode_state);
                },
                transcodePendingCount: function() {
                    return this.transcodeItems.filter(t => t.transcode_state === 'pending').length;
                },
                // 專輯頁「播放」按鈕的狀態：現在播放中／暫停中的歌曲屬於這張專輯時，按鈕變成「暫停」／「繼放」（從暫停處繼續）；否則是「播放」（從第 1 首開始）
                albumPlayState: function() {
                    if (!this.musicFolder || !this.nowPlaying.id) {
                        return 'start';
                    }
                    if (!this.musicFolder.tracks.some(t => t.item.id === this.nowPlaying.id)) {
                        return 'start';
                    }
                    return this.nowPlaying.paused ? 'resume' : 'pause';
                },
                // MKV 編碼提示：伺服器回報編碼，這裡用瀏覽器自己的 canPlayType 判斷能不能播；都能播就沒有提示
                mediaHintWarnings: function() {
                    let info = this.mediaInfo;
                    if (!info || !info.file) {
                        return [];
                    }
                    let probe = document.createElement('video');
                    let can = (type) => probe.canPlayType ? probe.canPlayType(type) : 'maybe';
                    let warnings = [];
                    if (can('video/x-matroska') === '' && can('video/webm') !== '') {
                        warnings.push('這個瀏覽器不支援 MKV 格式');
                    }
                    (info.video || []).forEach(v => {
                        if (v.always_unsupported || (v.mime && can('video/mp4; codecs="' + v.mime + '"') === '')) {
                            warnings.push('影片 ' + v.label + ' 不支援');
                        }
                    });
                    let audio = info.audio || [];
                    let main = audio.find(a => a.is_default) || audio[0];
                    if (main && main.mime && can('audio/mp4; codecs="' + main.mime + '"') === '') {
                        warnings.push('預設音軌 ' + main.label + ' 可能沒有聲音');
                    }
                    return warnings;
                },
                mediaHintDetail: function() {
                    let info = this.mediaInfo;
                    if (!info || !info.file) {
                        return '';
                    }
                    let v = (info.video || []).map(x => x.label).join(', ') || '?';
                    let a = (info.audio || []).map(x => x.label).join(', ') || '無';
                    return info.file + '：影片 ' + v + ' · 音訊 ' + a;
                },
                hasMusicItems: function() {
                    return this.items.some(t => t.type === 'music') || this.musicGridVisible;
                },
                // 資料夾內沒有子資料夾/音樂、影片 >= 2 部（搜尋等跨資料夾清單不算）時，視為影片資料夾
                videoFolder: function() {
                    let all = this.allItems;
                    if (all.length === 0 || all.some(t => t.path || t.type === 'folder' || t.type === 'music')) {
                        return null;
                    }
                    let videos = all.filter(t => t.type === 'video');
                    // 影片 >= 2 部，或剛好 1 部但長度 < 30 分鐘（視為單集的追番資料夾）
                    if (videos.length === 0 || (videos.length === 1 && !(videos[0].duration > 0 && videos[0].duration < 1800))) {
                        return null;
                    }
                    let eps = videos.map(v => ({ item: v, no: this.vm_parseEpisode(v.title) }));
                    let nums = eps.map(e => e.no);
                    let parsedOk = nums.every(n => n !== null) && new Set(nums).size === nums.length;
                    if (parsedOk) {
                        eps.sort((a, b) => a.no - b.no);
                    } else {
                        eps.forEach((e, i) => { e.no = i + 1; });
                    }
                    eps.forEach(e => { e.label = (e.no < 10 ? '0' : '') + e.no; });
                    let last = this.breadcrumbs.length ? this.breadcrumbs[this.breadcrumbs.length - 1] : null;
                    let q = /(\d{3,4}[pP])/.exec(videos[0].title);
                    return {
                        // 可評分的動畫資料夾：標題用去掉結尾星等的名稱（星等另外顯示在「我的評分」，避免兩邊對不上）
                        title: this.currentRating ? this.currentRating.name : (last && last.text ? last.text : ''),
                        episodes: eps,
                        quality: q ? q[1].toUpperCase() : ''
                    };
                },
                videoGridVisible: function() {
                    return !!this.videoFolder && !this.showListView;
                },
                // 追番畫面已把資料夾名稱當標題顯示，麵包屑不重複顯示最後一層
                displayBreadcrumbs: function() {
                    if ((this.videoGridVisible || this.musicGridVisible) && this.breadcrumbs.length > 1) {
                        return this.breadcrumbs.slice(0, -1);
                    }
                    if (this.currentRating && this.breadcrumbs.length > 0) {
                        // 最後一層（目前的動畫資料夾）同樣去掉結尾星等
                        let list = this.breadcrumbs.slice();
                        list[list.length - 1] = Object.assign({}, list[list.length - 1], { text: this.currentRating.name });
                        return list;
                    }
                    return this.breadcrumbs;
                },
                // 資料夾內只有 1 部影片（沒有子資料夾/音樂，搜尋等跨資料夾清單不算）
                singleVideo: function() {
                    let all = this.allItems;
                    if (all.length === 0 || all.some(t => t.path || t.type === 'folder' || t.type === 'music')) {
                        return null;
                    }
                    let videos = all.filter(t => t.type === 'video');
                    return videos.length === 1 ? videos[0] : null;
                },
                // 只有 1 集的作品頁：封面（Folder.jpg、cover.jpg…）已經顯示在頁面上方，就不再把它當成檔案列在下面的列表；回傳那個封面檔的 id，沒有就是 null
                hiddenCoverFileId: function() {
                    if (!this.singleVideo || !this.videoCoverUrl) {
                        return null;
                    }
                    let names = ['cover.jpg', 'cover.jpeg', 'cover.png', 'folder.jpg', 'folder.jpeg', 'folder.png'];
                    for (let i = 0; i < names.length; i++) {
                        let found = this.allItems.find(t => t.type === 'image' && t.title.toLowerCase() === names[i]);
                        if (found) {
                            return found.id;
                        }
                    }
                    return null;
                },
                // 要顯示封面的影片：追番畫面取第 1 集，單部影片取它自己
                coverVideoItem: function() {
                    if (this.videoFolder) {
                        return this.videoFolder.episodes[0].item;
                    }
                    if (this.musicFolder) {
                        return this.musicFolder.tracks[0].item;
                    }
                    return this.singleVideo;
                },
                // 音樂資料夾（專輯/歌單版面）：
                //  1) 沒有子資料夾、沒有影片、音樂 >= 3 首；
                //  2) 多片裝：母資料夾只有光碟子資料夾，伺服器已把各光碟的歌曲放在 discGroups，合計 >= 3 首。
                // 搜尋等跨資料夾清單不算
                musicFolder: function() {
                    let all = this.allItems;
                    if (all.length === 0 || all.some(t => t.path || t.type === 'video')) {
                        return null;
                    }
                    let groups;
                    if (this.discGroups && this.discGroups.length >= 2) {
                        if (all.some(t => t.type === 'music')) {
                            return null;
                        }
                        groups = this.discGroups.map(d => ({ title: d.title, items: d.items }));
                    } else {
                        if (all.some(t => t.type === 'folder')) {
                            return null;
                        }
                        groups = [{ title: '', items: all.filter(t => t.type === 'music') }];
                    }
                    let musics = [];
                    groups.forEach(g => g.items.forEach(m => musics.push(m)));
                    if (musics.length < 3) {
                        return null;
                    }

                    // 各光碟（或單一資料夾）內的曲序：ID3 音軌編號（都有且不重複）-> 檔名開頭數字 -> 原本順序
                    let usable = a => a.every(n => n != null && n > 0) && new Set(a).size === a.length;
                    let ordered = groups.map(g => {
                        let byTag = g.items.map(m => m.track);
                        let byName = g.items.map(m => this.vm_leadingNumber(m.title));
                        let order = usable(byTag) ? byTag : (usable(byName) ? byName : g.items.map((m, i) => i));
                        let sorted = g.items.map((m, i) => ({ item: m, key: order[i] })).sort((a, b) => a.key - b.key).map(x => x.item);
                        return { title: g.title, items: sorted };
                    });

                    let most = vals => {
                        let counts = {};
                        vals.forEach(v => { counts[v] = (counts[v] || 0) + 1; });
                        let best = null;
                        Object.keys(counts).forEach(k => {
                            if (!best || counts[k] > best.n) {
                                best = { value: k, n: counts[k] };
                            }
                        });
                        return best;
                    };
                    let total = musics.length;
                    // 專輯名稱先去掉光碟後綴（Album (Disc 1)、Album [CD2]），不然各光碟名稱不同會被判成歌單
                    let album = most(musics.map(m => m.album).filter(Boolean).map(a => this.vm_albumBase(a)));
                    let isAlbum = !!album && album.n / total >= 0.6;
                    let artistVals = musics.map(m => m.album_artist || m.artist).filter(Boolean);
                    let topArtist = most(artistVals);
                    let artist = '';
                    if (topArtist) {
                        artist = topArtist.n / total >= 0.6 ? topArtist.value : '多位演出者';
                    }
                    let year = isAlbum ? most(musics.map(m => m.year).filter(Boolean)) : null;
                    let last = this.breadcrumbs.length ? this.breadcrumbs[this.breadcrumbs.length - 1] : null;
                    let folderName = last && last.text ? last.text : '';
                    let seconds = 0;
                    musics.forEach(m => { seconds += m.duration || 0; });

                    let outGroups = ordered.map(g => {
                        let gSeconds = 0;
                        g.items.forEach(m => { gSeconds += m.duration || 0; });
                        return {
                            title: g.title,
                            seconds: gSeconds,
                            tracks: g.items.map((m, i) => ({
                                item: m,
                                no: i + 1,
                                title: m.track_title || this.vm_cleanTrackName(m.title),
                                // 只在跟專輯演出者不同（合輯）或歌單模式時顯示每首的演出者
                                artist: (m.artist && (!isAlbum || artist === '多位演出者' || m.artist !== artist)) ? m.artist : ''
                            }))
                        };
                    });
                    let flat = [];
                    outGroups.forEach(g => g.tracks.forEach(t => flat.push(t)));

                    return {
                        title: isAlbum ? album.value : folderName,
                        artist: isAlbum ? artist : '',
                        year: year ? year.value : '',
                        folderName: folderName,
                        totalSeconds: seconds,
                        groups: outGroups,
                        tracks: flat
                    };
                },
                musicGridVisible: function() {
                    return !!this.musicFolder && !this.showListView;
                },
                videoFolderKey: function() {
                    return this.coverVideoItem ? this.coverVideoItem.id : '';
                },
                // 目前瀏覽的資料夾 id（麵包屑最後一層）；專輯的「收藏」就是收藏這個資料夾
                currentFolderId: function() {
                    let last = this.breadcrumbs.length ? this.breadcrumbs[this.breadcrumbs.length - 1] : null;
                    return last && last.id ? last.id : '';
                },
                watchedCount: function() {
                    if (!this.videoFolder) {
                        return 0;
                    }
                    return this.videoFolder.episodes.filter(e => this.vm_epState(e.item.id) === 'watched').length;
                },
                favAlbumCount: function() {
                    return this.allItems.filter(t => t.type === 'folder').length;
                },
                favTrackCount: function() {
                    return this.allItems.filter(t => t.type === 'music').length;
                },
                filterOptions: function() {
                    if (this.favView) {
                        return [];
                    }
                    let types = [
                        {type: 'music', label: '🎵 音樂'},
                        {type: 'video', label: '🎬 影片'},
                        {type: 'image', label: '🖼 圖片'}
                    ];
                    return types.filter(o => this.allItems.some(t => t.type === o.type && t.id !== this.hiddenCoverFileId));
                }
            },
            watch: {
                videoFolderKey: function (key) {
                    this.showListView = false;
                    this.videoCoverUrl = '';
                    if (!key) {
                        return;
                    }
                    let cover = this.vm_findCoverUrl(this.allItems.filter(t => t.type === 'video'));
                    if (cover) {
                        this.videoCoverUrl = cover;
                    } else if (this.isLoggedIn !== false) {
                        // 依序嘗試：內嵌封面 -> （僅追番畫面）擷取第 1 集畫面
                        let first = this.coverVideoItem;
                        this.vm_loadCover(this.vm_coverApiUrl(first)).then(dataUrl => {
                            if (this.videoFolderKey === key) {
                                this.videoCoverUrl = dataUrl;
                            }
                        }).catch(() => {
                            if (this.videoFolderKey === key && this.videoFolder) {
                                this.vm_captureCover(first, key);
                            }
                        });
                    }
                },
                videoRate: function (v) {
                    try { window.localStorage.setItem('videoRate', String(v)); } catch (e) { }
                    if (this.$refs.videoEl) {
                        this.$refs.videoEl.playbackRate = v;
                    }
                },
                favTab: function (v) {
                    try { window.localStorage.setItem('favTab', v); } catch (e) { }
                },
                allItems: function () {
                    this.vm_scheduleTranscodePoll();
                },
                discGroups: function () {
                    this.vm_scheduleTranscodePoll();
                },
                flacOriginal: function (v) {
                    try { window.localStorage.setItem('flacOriginal', v ? '1' : '0'); } catch (e) { }
                },
                loudnessOn: function (v) {
                    try { window.localStorage.setItem('loudnessOn', v ? '1' : '0'); } catch (e) { }
                    if (this.nowPlaying.id) {
                        this.vm_applyTrackGain(this.nowPlaying.id);
                    }
                },
                autoNext: function (v) {
                    try { window.localStorage.setItem('autoNext', v ? '1' : '0'); } catch (e) { }
                },
                autoLoop: function (v) {
                    try { window.localStorage.setItem('autoLoop', v ? '1' : '0'); } catch (e) { }
                }
            },
            created: function() {
                let self = this;
                try {
                    let savedNext = window.localStorage.getItem('autoNext');
                    let savedLoop = window.localStorage.getItem('autoLoop');
                    if (savedNext !== null) { this.autoNext = savedNext === '1'; }
                    if (savedLoop !== null) { this.autoLoop = savedLoop === '1'; }
                    let savedFavTab = window.localStorage.getItem('favTab');
                    if (savedFavTab === 'album' || savedFavTab === 'track') { this.favTab = savedFavTab; }
                    let savedLoudness = window.localStorage.getItem('loudnessOn');
                    if (savedLoudness !== null) { this.loudnessOn = savedLoudness === '1'; }
                    this.flacOriginal = window.localStorage.getItem('flacOriginal') === '1';
                    let savedRate = parseFloat(window.localStorage.getItem('videoRate'));
                    if (savedRate > 0) { this.videoRate = savedRate; }
                    let savedProgress = window.localStorage.getItem('videoProgress');
                    if (savedProgress) { this.videoProgress = JSON.parse(savedProgress) || {}; }
                } catch (e) { }
                window.addEventListener('pagehide', function () { self.vm_saveCurrentVideoProgress(); });
                window.onpopstate = function () {
                    if (event.state && event.state.news) {
                        self.vm_showNews(false);
                        return;
                    }
                    if (event.state) {
                        console.log('pop-state:', event.state);
                        let itemId = event.state.folder;
                        let keyword = event.state.keyword;
                        if (itemId != null) {
                            self.vm_getFolder(itemId, false);
                        }
                        if (keyword) {
                            console.log('found keyword:' + keyword);                                                        
                            self.doSearch(keyword);
                        }
                    }
                };
            },
            mounted: function() {
                window.addEventListener("keydown", this.handleKeyDownEvent);
                document.addEventListener("click", this.handleDocumentClick);
                this.pendingPlayId = new URLSearchParams(window.location.search).get('playId');
                api.info().then(res => {
                    this.isLoggedIn = !!res.data.name;
                    this.newsEnabled = res.data.news !== null && res.data.news !== undefined;
                    this.transcodeEnabled = !!res.data.transcode;
                    this.isAdmin = !!res.data.admin;
                    this.newsUnread = res.data.news || 0;
                    if (this.isLoggedIn) {
                        this.vm_loadFavorites();
                    }
                }).catch(err => {
                    console.log('error response from api.info with ', err.response);
                });
                document.addEventListener('visibilitychange', () => {
                    if (document.visibilityState === 'hidden') {
                        this.lastHiddenAt = Date.now();
                        // 有些瀏覽器是先暫停、後觸發隱藏：2 秒內剛被暫停的也算被打斷
                        if (this.audioIntent === 'play' && this.audioInterruptedAt === 0 && window.audio && window.audio.paused && !window.audio.ended
                            && Date.now() - this.audioLastPauseAt < 2000) {
                            this.audioInterruptedAt = Date.now();
                        }
                    }
                    if (document.visibilityState === 'visible') {
                        this.vm_refreshNewsUnread();
                        this.vm_tryResumeAfterInterruption();
                    }
                });
                window.addEventListener('pageshow', () => { this.vm_tryResumeAfterInterruption(); });
                // 使用者自己捲動畫面（滾輪、觸控、翻頁鍵）時記下時間：換歌時 8 秒內不自動捲動，避免把正在瀏覽別處的人拉走
                let markUserScroll = () => { this.lastUserScrollAt = Date.now(); };
                window.addEventListener('wheel', markUserScroll, { passive: true });
                window.addEventListener('touchmove', markUserScroll, { passive: true });
                window.addEventListener('keydown', e => {
                    if ([32, 33, 34, 35, 36].indexOf(e.keyCode) !== -1 && ['INPUT', 'TEXTAREA', 'SELECT'].indexOf((e.target && e.target.tagName) || '') === -1) {
                        markUserScroll();
                    }
                });
                window.setInterval(() => { this.vm_refreshNewsUnread(); }, 180000);
                let pathname = window.location.pathname;
                if (/^\/page\/news\/?$/i.test(pathname)) {
                    this.vm_showNews(false, true);
                    return;
                }
                api.pathId(pathname).then(res=>{
                    console.log('pathid:' + res.data.pathId);                    
                    this.vm_getFolder(res.data.pathId, true);
                }).catch(err=> {
                    console.log('error response from api.pathId with ', err.response);
                });                
            },
            destroyed() {
                window.removeEventListener("keydown", this.handleKeyDownEvent);
                document.removeEventListener("click", this.handleDocumentClick);
            },
            methods: {
                toggleMenu: function() {
                    this.menuOpen = !this.menuOpen;
                },
                handleDocumentClick: function(evt) {
                    if (evt.target.closest('.lightbox-overlay')) {
                        return;
                    }
                    this.menuOpen = false;
                    if (this.searchIsVisible && evt.target.closest('.search-component-wrapper') == null) {
                        this.toggleBarMode();
                    }
                },
                vm_menuAction: function(fn) {
                    this.menuOpen = false;
                    fn();
                },
                toggleBarMode: function() {
                    if (this.searchIsVisible == false) {
                        this.searchIsVisible = true;
                        this.breadcrumbIsVisible = false;
                        this.searchPerformed = false;
                        window.setTimeout(function() {
                            let el = document.querySelector('.search-component-input');
                            if (el) {
                                el.value = '';
                                el.focus();
                            }
                        }, 50);
                    } else {
                        this.searchIsVisible = false;
                        this.breadcrumbIsVisible = true;
                    }
                },
                vm_backToBrowse: function() {
                    this.toggleBarMode();
                    let folder = window.localStorage.getItem('lastFolder') || '';
                    this.vm_getFolder(folder, true);
                },
                // 星星圖示：滿星 / 半星 / 空星
                vm_starClass: function (rating, n) {
                    let r = rating > 0 ? rating : 0;
                    if (r >= n) { return 'fa-solid fa-star'; }
                    if (r >= n - 0.5) { return 'fa-solid fa-star-half-stroke'; }
                    return 'fa-regular fa-star';
                },
                // 評分：點星星區域打開底部面板，從 0.5～5 十個數字按鈕挑一個（或清除）；
                // 星星本身只負責顯示，所以不會因為點太小而誤改分數
                vm_openRatingPicker: function (holder, id, name) {
                    if (this.isLoggedIn === false) {
                        this.redirectToLogin('');
                        return;
                    }
                    let current = holder.rating > 0 ? holder.rating : 0;
                    // value：已儲存的分數；pending：面板上選擇中的分數（按「確定」才會儲存）
                    this.ratingPicker = { holder: holder, id: id, name: name, value: current, pending: current };
                },
                vm_openItemRating: function (item) {
                    this.vm_openRatingPicker(item, item.id, item.title_plain);
                },
                // 進入動畫資料夾時，如果裡面有 MKV，向伺服器要第一個 MKV 的編碼資訊（結果依資料夾 id 對應，過期的回應不採用）
                vm_loadMediaInfo: function (res, items) {
                    this.mediaInfo = null;
                    if (!res.current || res.current.kind !== 'anime' || !res.id || !items.some(t => t.type === 'video' && /\.mkv$/i.test(t.title))) {
                        return;
                    }
                    let folderId = res.id;
                    api.mediaInfo(folderId).then(r => {
                        if (this.currentRating && this.currentRating.id === folderId) {
                            this.mediaInfo = r.data;
                        }
                    }).catch(() => { });
                },
                vm_unplayDate: function (ms) {
                    if (!ms) {
                        return '';
                    }
                    let d = new Date(ms);
                    return d.getFullYear() + '/' + (d.getMonth() + 1) + '/' + d.getDate();
                },
                // 管理者標註／取消「無法播放」（這個動畫資料夾）；先改畫面，失敗再還原
                vm_toggleUnplayable: function () {
                    let cr = this.currentRating;
                    if (!cr || cr.kind !== 'anime') {
                        return;
                    }
                    api.setUnplayable(cr.id, !cr.unplayable).then(res => {
                        cr.unplayable = !!res.data.unplayable;
                        cr.unplayable_by = res.data.unplayable_by;
                        cr.unplayable_time = res.data.unplayable_time;
                    }).catch(err => {
                        let st = err && err.response ? err.response.status : 0;
                        if (st === 401) {
                            this.redirectToLogin('');
                        } else if (st === 403) {
                            alert('只有管理者可以標註');
                        } else {
                            alert('標註失敗，請稍後再試');
                        }
                    });
                },
                vm_openCurrentRating: function () {
                    if (this.currentRating) {
                        this.vm_openRatingPicker(this.currentRating, this.currentRating.id, this.currentRating.name);
                    }
                },
                vm_closeRatingPicker: function () {
                    this.ratingPicker = null;
                },
                vm_selectRating: function (value) {
                    if (this.ratingPicker) {
                        this.ratingPicker.pending = value;
                    }
                },
                vm_confirmRating: function () {
                    let p = this.ratingPicker;
                    this.ratingPicker = null;
                    if (p && p.pending !== p.value) {
                        this.vm_saveRating(p.holder, p.id, p.pending);
                    }
                },
                // 先改畫面，伺服器失敗再還原
                vm_saveRating: function (holder, id, value) {
                    let old = holder.rating;
                    if ((old > 0 ? old : 0) === value) {
                        return;
                    }
                    holder.rating = value;
                    api.setRating(id, value).catch(err => {
                        holder.rating = old;
                        let st = err && err.response ? err.response.status : 0;
                        if (st === 401) {
                            this.redirectToLogin('');
                        } else {
                            alert('儲存評分失敗，請稍後再試');
                        }
                    });
                },
                // ----- 新上架（站內通知） -----
                vm_refreshNewsUnread: function () {
                    if (!this.newsEnabled || this.isLoggedIn !== true) {
                        return;
                    }
                    api.info().then(res => {
                        // 正在看新上架頁時，未讀一律是 0（打開頁面就已讀）
                        this.newsUnread = this.newsView ? 0 : (res.data.news || 0);
                    }).catch(() => { });
                },
                // 打開新上架頁就視為已讀：清單裡這次進來時還沒讀的仍會有紅點，離開後下次就沒有了
                vm_openNewsPage: function () {
                    this.vm_showNews(true);
                },
                vm_setNewsRange: function (days) {
                    this.newsRange = days;
                    try { window.localStorage.setItem('newsRange', String(days)); } catch (e) { }
                },
                // pushState：切換到 /page/news/；fromUrl：是從網址直接進來的（重整），用 replaceState 並在停用／失敗時退回首頁
                vm_showNews: function (pushState, fromUrl) {
                    let self = this;
                    this.loading = true;
                    api.news().then(res => {
                        if (fromUrl && res.data.enabled === false) {
                            location.replace('/page/');
                            return;
                        }
                        self.newsEntries = res.data.items || [];
                        let saved = 0;
                        try { saved = parseInt(window.localStorage.getItem('newsRange')) || 0; } catch (e) { }
                        let tabs = self.newsRangeTabs;
                        let pick = tabs.find(t => t.days === saved) || tabs[0];
                        if (pick.count === 0) {
                            pick = tabs.find(t => t.count > 0) || pick;        // 選到的範圍沒有資料時，改選第一個有資料的
                        }
                        self.newsRange = pick.days;
                        if (pushState) {
                            window.history.pushState({ news: true }, '', '/page/news/');
                        } else if (fromUrl) {
                            window.history.replaceState({ news: true }, '', '/page/news/');
                        }
                        self.newsView = true;
                        self.favView = false;
                        self.allItems = [];
                        self.discGroups = null;
                        self.notFound = null;
                        self.loadError = '';
                        self.activeFilter = null;
                        self.currentRating = null;
                        self.breadcrumbs = [
                            { id: '', text: '我的分享' },
                            { id: null, text: '新上架' }
                        ];
                        self.searchIsVisible = false;
                        self.breadcrumbIsVisible = true;
                        self.footerMessage = '共 ' + self.newsEntries.length + ' 筆.';
                        if (self.newsUnread > 0 || res.data.unread > 0) {
                            api.newsRead().then(() => { self.newsUnread = 0; }).catch(() => { });
                        }
                    }).catch(err => {
                        if (err && err.response && err.response.status === 401) {
                            self.redirectToLogin('');
                        } else {
                            alert('載入新上架失敗，請稍後再試');
                        }
                    }).finally(() => {
                        self.loading = false;
                    });
                },
                vm_openNews: function (e) {
                    this.vm_getFolder(e.folderId, true);
                },
                // 資料夾列表裡的「新」標記文字：資料夾沿用新上架頁的說法，檔案（新集數）就是「新」
                vm_newsBadgeText: function (item) {
                    if (item.news_kind === 'file') {
                        return '新';
                    }
                    if (item.news_kind === 'series') {
                        return '新作品';
                    }
                    return this.vm_newsLabel({ kind: item.news_kind, count: item.news_count });
                },
                vm_newsLabel: function (e) {
                    if (e.kind === 'album') {
                        return '新專輯';
                    }
                    return e.kind === 'series' ? ('新作品 · ' + e.count + ' 集') : ('新增 ' + e.count + ' 集');
                },
                vm_newsTime: function (ms) {
                    let d = new Date(ms);
                    let pad = n => (n < 10 ? '0' : '') + n;
                    let diff = Date.now() - ms;
                    let now = new Date();
                    let sameDay = d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth() && d.getDate() === now.getDate();
                    if (sameDay) {
                        if (diff < 60000) { return '剛剛'; }
                        if (diff < 3600000) { return Math.floor(diff / 60000) + ' 分鐘前'; }
                        return Math.floor(diff / 3600000) + ' 小時前';
                    }
                    return pad(d.getHours()) + ':' + pad(d.getMinutes());
                },
                // ----- 回到播放中的資料夾 -----
                // 資料夾/檔案 id 是「相對路徑的 URL-safe Base64（UTF-8）」，所以能從播放中歌曲的 id 直接推出它所在的資料夾
                vm_idToPath: function (id) {
                    try {
                        let b = (id || '').replace(/-/g, '+').replace(/_/g, '/');
                        while (b.length % 4) { b += '='; }
                        return decodeURIComponent(escape(atob(b)));
                    } catch (e) {
                        return '';
                    }
                },
                vm_pathToId: function (path) {
                    return btoa(unescape(encodeURIComponent(path))).replace(/=+$/, '').replace(/\+/g, '-').replace(/\//g, '_');
                },
                vm_playingFolderPath: function () {
                    let p = this.vm_idToPath(this.nowPlaying.id);
                    let i = p.lastIndexOf('/');
                    return i > 0 ? p.substring(0, i) : '';
                },
                // 清單重新載入後，播放中那首要重新標成「播放中」（否則離開再回來，聲音還在播、列上卻沒有標示）
                vm_markPlaying: function (items, discs) {
                    let id = this.nowPlaying.id;
                    if (!id) {
                        return;
                    }
                    let mark = list => (list || []).forEach(t => { if (t.type === 'music') { t.playing = (t.id === id); } });
                    mark(items);
                    (discs || []).forEach(d => mark(d.items));
                },
                // 把播放中那首選取並捲到畫面中間
                vm_revealPlaying: function () {
                    if (this.nowPlaying.id) {
                        this.setSelectedItem(this.nowPlaying.id);
                    }
                    window.setTimeout(() => {
                        this.$nextTick(() => {
                            let el = document.querySelector('.track-playing') || document.querySelector('.selected-item-row');
                            if (el && el.scrollIntoView) {
                                // 頁面全域是平滑捲動（scroll-behavior: smooth），這裡是「換了頁面直接定位」，暫時關掉平滑效果
                                let root = document.documentElement;
                                let prev = root.style.scrollBehavior;
                                root.style.scrollBehavior = 'auto';
                                el.scrollIntoView({ block: 'center' });
                                root.style.scrollBehavior = prev;
                            }
                        });
                    }, 120);
                },
                vm_goPlayingFolder: function () {
                    let path = this.vm_playingFolderPath();
                    if (!path) {
                        return;
                    }
                    // 已經在那個資料夾就只要捲到那一首（搜尋結果的麵包屑還停在搜尋前的資料夾，所以搜尋模式不算；見 inPlayingFolder）
                    if (this.inPlayingFolder) {
                        this.vm_revealPlaying();
                        return;
                    }
                    this.vm_getFolder(this.vm_pathToId(path), true, true);
                },
                // ----- 資料夾排序：以資料夾為單位記在這個瀏覽器（localStorage 的 sortPrefs），預設維持伺服器給的順序 -----
                vm_readSortPrefs: function () {
                    try {
                        let o = JSON.parse(window.localStorage.getItem('sortPrefs') || '{}');
                        return (o && typeof o === 'object') ? o : {};
                    } catch (e) {
                        return {};
                    }
                },
                vm_loadSortPref: function (folderId, isRatingList) {
                    // 已存的選擇不在清單內（例如 1.10.0 曾有的「大小」排序）就視為預設
                    let valid = ['default', 'name', 'time_desc', 'time_asc', 'rating_desc', 'rating_asc'];
                    let mode = folderId ? this.vm_readSortPrefs()[folderId] : null;
                    if (mode && valid.indexOf(mode) !== -1 && (isRatingList || mode.indexOf('rating_') !== 0)) {
                        return mode;
                    }
                    if (isRatingList && !mode) {
                        // 舊版（1.9.x）的評分列表排序是整個瀏覽器共用一個值，沒有個別記憶時沿用
                        try {
                            let old = window.localStorage.getItem('ratingSort');
                            if (old === 'high') { return 'rating_desc'; }
                            if (old === 'low') { return 'rating_asc'; }
                        } catch (e) { }
                    }
                    return 'default';
                },
                vm_saveSortPref: function () {
                    let id = this.sortFolderId;
                    if (!id) {
                        return;
                    }
                    let prefs = this.vm_readSortPrefs();
                    delete prefs[id];
                    if (this.sortMode !== 'default') {
                        prefs[id] = this.sortMode;
                    } else if (this.ratingList) {
                        // 評分列表選回「預設」時要明確記住，否則會又被舊版的全域值蓋回去
                        prefs[id] = 'default';
                    }
                    let keys = Object.keys(prefs);
                    if (keys.length > 300) {
                        keys.slice(0, keys.length - 300).forEach(k => { delete prefs[k]; });
                    }
                    try { window.localStorage.setItem('sortPrefs', JSON.stringify(prefs)); } catch (e) { }
                },
                // 排序：資料夾永遠在檔案前面；各組內依選擇排序，同值維持原順序（穩定排序）。
                // 沒有的欄位（例如檔案沒有評分）一律排在後面
                vm_sortItems: function (list) {
                    let mode = this.sortMode;
                    if (mode === 'default' || list.length < 2 || list.some(t => t.path)) {
                        return list;
                    }
                    let name = t => (t.rateable ? t.title_plain : t.title) || '';
                    let byName = (a, b) => name(a).localeCompare(name(b), undefined, { numeric: true, sensitivity: 'base' });
                    let num = (v) => (typeof v === 'number' && !isNaN(v)) ? v : null;
                    let key = null, dir = 1, tie = null;
                    if (mode === 'name') {
                        key = null;
                    } else if (mode === 'time_desc' || mode === 'time_asc') {
                        key = t => num(t.modify_ts);
                        dir = mode === 'time_desc' ? -1 : 1;
                        tie = byName;
                    } else if (mode === 'rating_desc' || mode === 'rating_asc') {
                        key = t => (t.rating > 0 ? t.rating : null);
                        dir = mode === 'rating_desc' ? -1 : 1;
                    } else {
                        return list;
                    }
                    let sortGroup = group => group.map((t, i) => ({ t: t, i: i })).sort((a, b) => {
                        if (key === null) {
                            let c = byName(a.t, b.t);
                            return c !== 0 ? c : a.i - b.i;
                        }
                        let ka = key(a.t), kb = key(b.t);
                        if (ka === null && kb === null) { return a.i - b.i; }
                        if (ka === null) { return 1; }
                        if (kb === null) { return -1; }
                        if (ka !== kb) { return (ka - kb) * dir; }
                        let c = tie ? tie(a.t, b.t) : 0;
                        return c !== 0 ? c : a.i - b.i;
                    }).map(x => x.t);
                    let folders = list.filter(t => t.type === 'folder');
                    let others = list.filter(t => t.type !== 'folder');
                    return sortGroup(folders).concat(sortGroup(others));
                },
                // 日期去掉秒數（2026/10/16 上午 09:53:37 → 2026/10/16 上午 09:53），讓出一點寬度給同一行的星星
                vm_shortDate: function (text) {
                    return (text || '').replace(/(\d{1,2}:\d{2}):\d{2}/, '$1');
                },
                vm_ratingText: function (name, rating) {
                    return name + '：' + (rating > 0 ? rating : '未評分');
                },
                vm_copyCurrentRating: function () {
                    if (this.currentRating) {
                        this.vm_copyText(this.vm_ratingText(this.currentRating.name, this.currentRating.rating));
                    }
                },
                // 複製目前清單（含目前的排序與篩選）：給人或語言模型看都容易懂的純文字，每行「名稱：評分」
                vm_copyRatingList: function () {
                    let rows = this.items.filter(t => t.rateable);
                    if (rows.length === 0) {
                        this.vm_toast('目前沒有可複製的項目');
                        return;
                    }
                    let last = this.breadcrumbs.length ? this.breadcrumbs[this.breadcrumbs.length - 1] : null;
                    let lines = [(last && last.text ? last.text + ' ' : '') + '動畫評分清單（滿分 5 分，以 0.5 為單位；未評分表示還沒打分）'];
                    rows.forEach(t => lines.push(this.vm_ratingText(t.title_plain, t.rating)));
                    this.vm_copyText(lines.join('\n'), rows.length + ' 筆');
                },
                vm_toast: function (msg) {
                    this.copyMsg = msg;
                    if (this.copyMsgTimer) {
                        clearTimeout(this.copyMsgTimer);
                    }
                    this.copyMsgTimer = setTimeout(() => { this.copyMsg = ''; }, 2000);
                },
                // 站台常是 HTTP（瀏覽器的一鍵複製 API 只在 HTTPS 可用），所以用「選取 + 複製指令」；
                // 還是失敗就跳出已全選的文字框讓使用者手動複製
                vm_copyText: function (text, label) {
                    let done = () => this.vm_toast('已複製' + (label ? '（' + label + '）' : ''));
                    let fallback = () => {
                        let ok = false;
                        try {
                            let ta = document.createElement('textarea');
                            ta.value = text;
                            ta.setAttribute('readonly', '');
                            ta.style.cssText = 'position:fixed; top:0; left:0; opacity:0; font-size:16px;';
                            document.body.appendChild(ta);
                            ta.focus();
                            ta.select();
                            ta.setSelectionRange(0, text.length);
                            ok = document.execCommand('copy');
                            document.body.removeChild(ta);
                        } catch (e) { }
                        if (ok) {
                            done();
                            return;
                        }
                        this.copyDialog = { text: text };
                        this.$nextTick(() => {
                            let el = document.getElementById('copyDialogText');
                            if (el) { el.focus(); el.select(); }
                        });
                    };
                    if (window.isSecureContext && navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(text).then(done, fallback);
                    } else {
                        fallback();
                    }
                },
                vm_loadFavorites: function () {
                    api.favorites().then(res => {
                        let albums = {};
                        let tracks = {};
                        (res.data.albums || []).forEach(id => { albums[id] = true; });
                        (res.data.tracks || []).forEach(id => { tracks[id] = true; });
                        this.favAlbumMap = albums;
                        this.favTrackMap = tracks;
                    }).catch(err => {
                        console.log('error response from api.favorites with ', err.response);
                    });
                },
                // 「我的最愛」：先列專輯（資料夾），再列歌曲；列表裡的歌曲就是播放佇列，等於一份虛擬精選歌單
                vm_showFavorites: function () {
                    let self = this;
                    this.loading = true;
                    api.favoriteItems().then((res) => {
                        self.allItems = res.data.items;
                        self.favView = true;
                        self.newsView = false;
                        self.currentRating = null;
                        self.favTarget = res.data.target;
                        self.favPending = res.data.pending || 0;
                        self.vm_scheduleFavPoll();
                        self.discGroups = null;
                        self.notFound = null;
                        self.loadError = '';
                        self.activeFilter = null;
                        self.breadcrumbs = [
                            { id: '', text: '我的分享' },
                            { id: null, text: '我的最愛' }
                        ];
                        self.searchIsVisible = false;
                        self.breadcrumbIsVisible = true;
                        self.footerMessage = res.data.message;
                    }).catch(err => {
                        if (err && err.response && err.response.status === 401) {
                            self.redirectToLogin('');
                        } else {
                            alert('載入我的最愛失敗，請稍後再試');
                        }
                    }).finally(() => {
