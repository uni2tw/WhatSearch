                    <option value="all">全部</option>
                    <option value="4">4 星↑</option>
                    <option value="3.5">3.5 星↑</option>
                    <option value="none">未評分</option>
                </select>
                <button type="button" class="btn btn-sm btn-outline-secondary" style="white-space:nowrap; flex:0 0 auto;" title="複製清單" v-on:click="vm_copyRatingList()">
                    <i class="fa fa-copy"></i> 複製
                </button>
