                    <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px;">
                        <button type="button" class="btn btn-success" v-on:click="vm_albumPlayClick()">
                            <i class="fa" :class="albumPlayState === 'pause' ? 'fa-pause' : 'fa-play'"></i> {{ albumPlayState === 'pause' ? '暫停' : (albumPlayState === 'resume' ? '繼放' : '播放') }}
                        </button>
                        <button v-if="isLoggedIn && currentFolderId" type="button" class="btn btn-sm"
