    <div class="now-playing-bar" v-if="nowPlaying.id" style="position:fixed; bottom:0; left:0; width:100%; background:#222; color:#fff; padding:6px 12px; z-index:1000;">
        <div style="display:flex; align-items:center;">
            <button type="button" class="btn" :class="resumeHint ? 'btn-success' : 'btn-outline-light'" v-on:click="vm_togglePause()" style="margin-right:10px; min-width:44px; min-height:44px;">
                <i class="fa" :class="nowPlaying.paused ? 'fa-play' : 'fa-pause'"></i>
            </button>
            <div style="flex-grow:1; overflow:hidden; margin-right:10px;">
                <div style="white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">{{ nowPlaying.title }}</div>
                <div v-if="resumeHint" style="font-size:11px; color:#8fd19e;">被其他 App 打斷了，點一下播放鍵繼續</div>
                <div v-if="nowPlaying.artist || nowPlaying.album || nowPlaying.format" style="font-size:11px; color:#aaa; white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">{{ formatArtistAlbum(nowPlaying) }}<span v-if="nowPlaying.format" :style="{color: nowPlaying.format === 'FLAC 原檔' ? '#e0b45c' : '#8fd19e'}">{{ (nowPlaying.artist || nowPlaying.album) ? ' · ' : '' }}{{ nowPlaying.format }}</span></div>
            </div>
            <div style="white-space:nowrap; font-size:12px;">{{ formatTime(seekingTime !== null ? seekingTime : nowPlaying.currentTime) }} / {{ formatTime(nowPlaying.duration) }}</div>
            <div v-if="isLoggedIn" class="fav-btn" :class="{'fav-on': favTrackMap[nowPlaying.id]}" title="加入最愛"
                v-on:click.stop="vm_toggleFav('track', nowPlaying.id)">
                <i :class="favTrackMap[nowPlaying.id] ? 'fa-solid fa-heart' : 'fa-regular fa-heart'"></i>
            </div>
        </div>
        <input type="range" min="0" :max="nowPlaying.duration || 0" step="0.1"
            :value="seekingTime !== null ? seekingTime : nowPlaying.currentTime"
            v-on:input="vm_seekInput" v-on:change="vm_seek" style="width:100%;" />
    </div>

    <div class="lightbox-overlay" v-if="nowPlayingVideo.id" v-on:click.self="vm_closeVideo()">
        <div class="lightbox-overlay-content">
            <div style="display:flex; justify-content:space-between; align-items:center; color:#fff; padding:6px 2px;">
                <div style="overflow:hidden; white-space:nowrap; text-overflow:ellipsis; margin-right:10px;">
                    <span v-if="nowPlayingVideo.label" class="badge bg-success me-2">{{ nowPlayingVideo.label }}</span>{{ nowPlayingVideo.title }}
                </div>
                <div style="display:flex; align-items:center; flex:0 0 auto;">
                    <select v-if="nowPlayingVideo.subtitles.length > 0" class="form-select form-select-sm"
                        style="width:auto; max-width:130px; margin-right:8px;" title="字幕"
                        :value="subtitleIndex" v-on:change="vm_pickSubtitle($event.target.value)">
                        <option value="-1">字幕：關閉</option>
                        <option v-for="(s, i) in nowPlayingVideo.subtitles" :key="s.url" :value="i">{{ s.label }}</option>
                    </select>
                    <select class="form-select form-select-sm" style="width:auto; margin-right:8px;" v-model.number="videoRate" title="播放速度">
                        <option :value="0.75">0.75x</option>
                        <option :value="1">1x</option>
                        <option :value="1.25">1.25x</option>
                        <option :value="1.5">1.5x</option>
                        <option :value="2">2x</option>
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-light" v-on:click="vm_closeVideo()">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
            </div>
            <div style="position:relative;" :style="{ minHeight: nowPlayingVideo.error ? '200px' : null }">
                <video ref="videoEl" class="player-video" :src="nowPlayingVideo.url" controls autoplay playsinline
                    style="width:100%; max-height:80vh; background:#000;"
                    v-on:loadedmetadata="vm_videoLoaded"
                    v-on:timeupdate="vm_videoTimeUpdate"
                    v-on:pause="vm_videoPause"
                    v-on:error="vm_videoError"
                    v-on:ended="vm_videoEnded">
                    <track v-for="s in nowPlayingVideo.subtitles" :key="nowPlayingVideo.id + s.url"
                        kind="subtitles" :src="s.url" :srclang="s.srclang" :label="s.label">
                </video>
                <div v-if="videoSlowHint && !nowPlayingVideo.error"
                        style="position:absolute; left:8px; right:8px; top:8px; z-index:5; background:rgba(0,0,0,0.8); color:#ffd54f; font-size:12px; line-height:1.5; padding:8px 30px 8px 10px; border-radius:6px;">
                    {{ videoSlowHint }}
                    <button type="button" class="btn-close btn-close-white" style="position:absolute; top:8px; right:8px; font-size:10px;"
                        v-on:click="videoSlowHint = ''"></button>
                </div>
                <div v-if="nowPlayingVideo.error"
                        style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; background:rgba(0,0,0,0.88); color:#fff; padding:16px; text-align:center;">
                    <i class="fa fa-triangle-exclamation" style="font-size:2rem; color:#ffc107;"></i>
                    <div style="max-width:90%;">{{ nowPlayingVideo.error }}</div>
                    <div style="display:flex; gap:8px; flex-wrap:wrap; justify-content:center;">
                        <a :href="nowPlayingVideo.url" download class="btn btn-sm btn-outline-light">
                            <i class="fa fa-download"></i> 下載檔案
                        </a>
                        <button v-if="isAdmin && currentRating && currentRating.kind === 'anime' && !currentRating.unplayable" type="button" class="btn btn-sm btn-outline-warning" v-on:click="vm_toggleUnplayable()">
                            <i class="fa fa-ban"></i> 無法播放
                        </button>
                        <button v-if="nowPlayingVideo.hasNext" type="button" class="btn btn-sm btn-success" v-on:click="vm_playNextVideo()">
                            <i class="fa fa-play"></i> 播放下一部
                        </button>
                    </div>
                </div>
                <div v-if="nowPlayingVideo.ended && nowPlayingVideo.hasNext"
                        style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,0.6);">
                    <button type="button" class="btn btn-success btn-lg" v-on:click="vm_playNextVideo()">
                        <i class="fa fa-play"></i> 播放下一部
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="lightbox-overlay" v-if="previewImage.id" v-on:click.self="vm_closeImagePreview()">
        <button type="button" class="btn btn-outline-light lightbox-nav-btn" style="left:10px"
