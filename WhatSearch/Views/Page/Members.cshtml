@model dynamic
@using WhatSearch.Core
@using WhatSearch.Controllers
@using WhatSearch.Utility
@{
    this.Layout = "_Layout.cshtml";
}

    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            const App = {
                data() {
                    return {
                        // 重設密碼對話框：member 是要重設的會員；password 是要設定的新密碼；done 表示已重設成功（這時還看得到密碼，方便複製）
                        reset: null,
                        // role：下拉選單目前選的身分；savedRole：已儲存的身分（兩者不同就是「尚未儲存」）
                        // 載入時排序：待啟用的在最上面（管理者進這頁多半是為了批准新會員），其次管理者，最後一般會員；之後儲存不會重新排序
                        members: JSON.parse(@Html.SerializeJson((object)Model)).map(function (m, i) {
                            var role = Number(m.status) !== 1 ? 'pending' : (m.admin ? 'admin' : 'member');
                            return Object.assign({}, m, { role: role, savedRole: role, saving: false, order: (role === 'pending' ? 0 : (role === 'admin' ? 1 : 2)) * 1000 + i });
                        }).sort(function (a, b) { return a.order - b.order; })
                    }
                },
                methods: {
                    vm_showAlert: function (text) {
                        var el = document.querySelector('.alert');
                        el.textContent = text;
                        el.style.display = 'block';
                        el.style.opacity = '1';
                        window.setTimeout(function () {
                            el.style.transition = 'opacity 0.4s';
                            el.style.opacity = '0';
                            window.setTimeout(function () {
                                el.style.display = 'none';
                            }, 400);
                        }, 3000);
                    },
                    vm_changed: function (member) {
                        return member.role !== member.savedRole;
                    },
                    // 降級或停用會先確認
                    vm_confirmText: function (member) {
                        if (member.savedRole === 'admin' && member.role !== 'admin') {
                            return '確定要取消「' + member.display + '」的管理者身分嗎？' + (member.role === 'pending' ? '（同時會停用這個帳號，他將無法登入）' : '');
                        }
                        if (member.savedRole !== 'pending' && member.role === 'pending') {
                            return '確定要停用「' + member.display + '」嗎？停用後他將無法登入。';
                        }
                        return '';
                    },
                    vm_update: function (member) {
                        var self = this;
                        var confirmText = self.vm_confirmText(member);
                        if (confirmText && !window.confirm(confirmText)) {
                            return;
                        }
                        member.saving = true;
                        axios.post('/admin/updateMember',
                            { 'name': member.name, 'role': member.role }
                        ).then(function(res) {
                            var data = res.data || {};
                            if (data.success === 1) {
                                member.savedRole = member.role;
                            } else {
                                // 伺服器拒絕（例如修改自己、取消最後一位管理者）：把選單還原成已儲存的身分
                                member.role = member.savedRole;
                            }
                            self.vm_showAlert(data.message || (data.success === 1 ? '已儲存' : '儲存失敗'));
                        }).catch(function(err){
                            member.role = member.savedRole;
                            self.vm_showAlert('儲存失敗，請稍後再試');
                        }).finally(function () {
                            member.saving = false;
                        });
                    },
                    // ----- 重設密碼 -----
                    // 隨機密碼：排除容易看錯的字元（0 O 1 l I）
                    vm_randomPassword: function () {
                        var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789';
                        var buf = new Uint32Array(10);
                        window.crypto.getRandomValues(buf);
                        var s = '';
                        for (var i = 0; i < buf.length; i++) {
                            s += chars.charAt(buf[i] % chars.length);
                        }
                        return s;
                    },
                    vm_openReset: function (member) {
                        this.reset = { member: member, password: this.vm_randomPassword(), done: false, saving: false, error: '', copied: false, copyFailed: false };
                        this.$nextTick(function () {
                            var el = document.querySelector('.reset-password-input');
                            if (el) { el.focus(); el.select(); }
                        });
                    },
                    vm_closeReset: function () {
                        this.reset = null;
                    },
                    vm_regenerate: function () {
                        if (this.reset && !this.reset.done) {
                            this.reset.password = this.vm_randomPassword();
                            this.reset.copied = false;
                        }
                    },
                    // 網站常是 HTTP，瀏覽器的一鍵複製 API 只在 HTTPS 可用，所以失敗時改用「選取＋複製指令」
                    vm_copyPassword: function () {
                        var self = this;
                        var text = self.reset ? self.reset.password : '';
                        var fallback = function () {
                            var el = document.querySelector('.reset-password-input');
                            if (el) {
                                el.focus();
                                el.select();
                                try { self.reset.copied = document.execCommand('copy'); } catch (e) { self.reset.copied = false; }
                                self.reset.copyFailed = !self.reset.copied;
                            }
                        };
                        if (navigator.clipboard && window.isSecureContext) {
                            navigator.clipboard.writeText(text).then(function () { self.reset.copied = true; self.reset.copyFailed = false; }, fallback);
                        } else {
                            fallback();
                        }
                    },
                    vm_submitReset: function () {
                        var self = this;
                        var r = self.reset;
                        if (!r || r.done || r.saving) {
                            return;
                        }
                        if (!r.password || r.password.trim().length === 0) {
                            r.error = '密碼不可空白';
                            return;
                        }
                        r.error = '';
                        r.saving = true;
                        axios.post('/admin/resetPassword', { 'name': r.member.name, 'password': r.password }).then(function (res) {
                            var data = res.data || {};
                            if (data.success === 1) {
                                r.done = true;
                                self.vm_showAlert(data.message || '已重設密碼');
                            } else {
                                r.error = data.message || '重設失敗';
                            }
                        }).catch(function () {
                            r.error = '重設失敗，請稍後再試';
                        }).finally(function () {
                            r.saving = false;
                        });
                    },
                    vm_resetKeydown: function (evt) {
                        if (evt.key === 'Escape') {
                            this.vm_closeReset();
                        } else if (evt.key === 'Enter') {
                            evt.preventDefault();
                            this.vm_submitReset();
                        }
                    },
                    vm_home: function () {
                        location.href = '/page';
                    },
                    formatDate: function (dateStr) {
                        if (!dateStr) {
                            return '';
                        }
                        return new Date(dateStr).toLocaleString();
                    },
                    // 上次登入的相對時間：今天、N 天前、N 個月前；新會員（登入時間等於註冊時間）顯示「從未登入」
                    formatLast: function (member) {
                        if (!member.access || member.access === member.create) {
                            return '從未登入';
                        }
                        var days = Math.floor((Date.now() - new Date(member.access).getTime()) / 86400000);
                        if (days <= 0) { return '今天'; }
                        if (days < 31) { return days + ' 天前'; }
                        if (days < 365) { return Math.floor(days / 30) + ' 個月前'; }
                        return Math.floor(days / 365) + ' 年前';
                    },
                    formatCreate: function (dateStr) {
                        return dateStr ? new Date(dateStr).toLocaleDateString() : '';
                    }
                }
            };
            window.app = Vue.createApp(App).mount('#main');
        });
    </script>

<body>
    <div id="main" class="container" style="max-width:900px; padding-top:16px;" v-cloak>
        <div class="alert alert-info" style="display:none; margin-bottom:10px"></div>
        <h1 class="h3" style="display:flex; align-items:center; gap:10px;">
            <button type="button" class="btn btn-sm btn-info" v-on:click="vm_home()" title="回首頁"><i class="fa fa-home"></i></button>
            會員管理
        </h1>
        <div style="font-size:13px; color:#666; margin:0 0 12px 0; line-height:2;">
            <span class="badge bg-warning text-dark"><i class="fa-solid fa-crown"></i> 管理者</span> 可進這個管理頁、標註動畫無法播放；
            <span class="badge bg-success">會員</span> 可登入、播放；
            <span class="badge bg-secondary">待啟用</span> 已註冊，改成「會員」或「管理者」並儲存後才能登入
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr style="font-size:13px; color:#888;">
                        <th>會員</th>
                        <th>身分</th>
                        <th>註冊</th>
                        <th>上次登入</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="member in members" :key="member.name" :class="{'table-warning': vm_changed(member)}">
                        <td class="memberName" :data-name="member.name" style="min-width:130px;">
                            <span>{{ member.display }}</span>
                            <span v-if="member.self" class="badge bg-info text-dark" style="margin-left:4px;">你</span>
                            <div style="font-size:12px; color:#888;">帳號 {{ member.name }}</div>
                        </td>
                        <td style="white-space:nowrap;">
                            <span v-if="member.savedRole === 'admin'" class="badge bg-warning text-dark"><i class="fa-solid fa-crown"></i> 管理者</span>
                            <span v-else-if="member.savedRole === 'member'" class="badge bg-success">會員</span>
                            <span v-else class="badge bg-secondary">待啟用</span>
                            <select class="form-select form-select-sm" style="display:inline-block; width:auto; margin-left:6px;"
                                v-model="member.role" :disabled="member.self || member.saving" :title="member.self ? '不能修改自己的身分' : '變更身分'">
                                <option value="admin">管理者</option>
                                <option value="member">會員</option>
                                <option value="pending">待啟用</option>
                            </select>
                        </td>
                        <td style="font-size:13px; color:#666; white-space:nowrap;">{{ formatCreate(member.create) }}</td>
                        <td style="font-size:13px; color:#666; white-space:nowrap;" :title="formatDate(member.access)">{{ formatLast(member) }}</td>
                        <td style="white-space:nowrap; text-align:right;">
                            <span v-if="vm_changed(member)" style="font-size:12px; color:#b26a00; margin-right:6px;">尚未儲存</span>
                            <button type="button" class="btn btn-sm btn-primary" :disabled="!vm_changed(member) || member.saving" v-on:click="vm_update(member)"><i class="fa fa-floppy-disk"></i> 儲存</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" style="margin-left:4px;" title="重設這位會員的密碼" v-on:click="vm_openReset(member)"><i class="fa fa-key"></i> 重設密碼</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div v-if="reset" style="position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:2000; display:flex; align-items:center; justify-content:center; padding:16px;" v-on:click.self="vm_closeReset()">
            <div style="background:#fff; border-radius:12px; padding:20px; width:100%; max-width:420px;" v-on:keydown="vm_resetKeydown">
                <h2 class="h5" style="margin-bottom:12px;"><i class="fa fa-key"></i> 重設密碼：{{ reset.member.display }}</h2>
                <div v-if="!reset.done">
                    <label style="font-size:13px; color:#666;" for="reset-password">新密碼（已先產生一組隨機密碼，可以直接用，也可以自己改）</label>
                    <div style="display:flex; gap:6px; margin-top:4px;">
                        <input id="reset-password" type="text" class="form-control reset-password-input" v-model="reset.password" autocomplete="off" spellcheck="false" style="font-family:monospace;" />
                        <button type="button" class="btn btn-outline-secondary" title="重新產生" v-on:click="vm_regenerate()"><i class="fa fa-dice"></i></button>
                        <button type="button" class="btn btn-outline-secondary" title="複製" v-on:click="vm_copyPassword()"><i class="fa fa-copy"></i></button>
                    </div>
                    <div v-if="reset.copied" style="font-size:12px; color:#198754; margin-top:4px;">已複製</div>
                    <div v-if="reset.copyFailed" style="font-size:12px; color:#b26a00; margin-top:4px;">瀏覽器不允許自動複製：密碼已選取，請按 Ctrl+C（手機請長按複製）</div>
                    <div v-if="reset.error" style="font-size:13px; color:#dc3545; margin-top:6px;">{{ reset.error }}</div>
                    <div style="font-size:12px; color:#888; margin-top:8px;">按下「確定重設」後，這位會員要改用新密碼登入；他已登入的裝置不受影響。新密碼只會在這裡顯示，請複製後再傳給對方。</div>
                    <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:14px;">
                        <button type="button" class="btn btn-outline-secondary" v-on:click="vm_closeReset()">取消</button>
                        <button type="button" class="btn btn-danger" :disabled="reset.saving" v-on:click="vm_submitReset()"><i class="fa fa-key"></i> 確定重設</button>
                    </div>
                </div>
                <div v-else>
                    <div style="font-size:14px; color:#198754;"><i class="fa fa-circle-check"></i> 已重設密碼。請把新密碼傳給對方：</div>
                    <div style="display:flex; gap:6px; margin-top:8px;">
                        <input type="text" class="form-control reset-password-input" :value="reset.password" readonly style="font-family:monospace;" />
                        <button type="button" class="btn btn-outline-secondary" title="複製" v-on:click="vm_copyPassword()"><i class="fa fa-copy"></i></button>
                    </div>
                    <div v-if="reset.copied" style="font-size:12px; color:#198754; margin-top:4px;">已複製</div>
                    <div v-if="reset.copyFailed" style="font-size:12px; color:#b26a00; margin-top:4px;">瀏覽器不允許自動複製：密碼已選取，請按 Ctrl+C（手機請長按複製）</div>
                    <div style="font-size:12px; color:#888; margin-top:8px;">關閉後就看不到這組密碼了。</div>
                    <div style="display:flex; justify-content:flex-end; margin-top:14px;">
                        <button type="button" class="btn btn-primary" v-on:click="vm_closeReset()">完成</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
